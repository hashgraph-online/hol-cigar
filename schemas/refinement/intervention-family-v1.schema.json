{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/intervention-family-v1.schema.json",
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "family_id", "trial_class", "owner_hints", "source_kinds", "metrics", "allowed_paths", "forbidden_paths", "named_gates", "base_priority", "budgets", "architecture_summary", "intervention_template"],
      "properties": {
        "schema_version": {"const": "cigar.refinement-intervention-family.v1"},
        "family_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "trial_class": {"enum": ["product", "infrastructure"]},
        "owner_hints": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}},
        "source_kinds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["kpi_cluster", "profiler", "mutation_survivor", "test_failure", "issue"]}},
        "metrics": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/shortText"}},
        "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/path"}},
        "forbidden_paths": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/path"}},
        "named_gates": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}},
        "base_priority": {"type": "number", "minimum": 0, "maximum": 100},
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "lines", "turns", "input_tokens", "output_tokens", "wall_seconds", "cost_usd"],
          "properties": {
            "files": {"type": "integer", "minimum": 1, "maximum": 10000},
            "lines": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "turns": {"type": "integer", "minimum": 1, "maximum": 1000},
            "input_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000000},
            "output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000000},
            "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
            "cost_usd": {"type": "number", "minimum": 0, "maximum": 1000000}
          }
        },
        "architecture_summary": {"$ref": "common-v1.schema.json#/$defs/longText"},
        "intervention_template": {"$ref": "common-v1.schema.json#/$defs/shortText"}
      }
    }
  },
  "allOf": [{"$ref": "#/$defs/family"}]
}
