{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/three-way-cohort-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cohort_id", "profile_id", "evidence_class", "kernel", "downstream", "scenario_classes", "execution_matrix", "measurement_rules", "content_safety"],
  "properties": {
    "schema_version": {"const": "cigar.three-way-cohort.v1"},
    "cohort_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "profile_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "evidence_class": {"const": "development"},
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development_manifest", "efficiency_fixtures", "task_count", "protected_strata"],
      "properties": {
        "development_manifest": {"$ref": "common-v1.schema.json#/$defs/artifactReference"},
        "efficiency_fixtures": {"$ref": "common-v1.schema.json#/$defs/artifactReference"},
        "task_count": {"const": 270},
        "protected_strata": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humidor_source", "cedar_source", "fixtures", "workflows"],
      "properties": {
        "humidor_source": {"$ref": "#/$defs/repositorySource"},
        "cedar_source": {"$ref": "#/$defs/repositorySource"},
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/externalArtifact"}
        },
        "workflows": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        }
      }
    },
    "scenario_classes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "execution_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_roles", "lanes", "assignment_seeds", "fresh_roots", "reliability_runs", "restart_boundaries"],
      "properties": {
        "source_roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["published-honey", "champion", "candidate"]}
        },
        "lanes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["kernel-source", "source-sidecar", "installed-sidecar", "humidor-source", "humidor-installed"]}
        },
        "assignment_seeds": {"const": 2},
        "fresh_roots": {"const": true},
        "reliability_runs": {"const": 3},
        "restart_boundaries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        }
      }
    },
    "measurement_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identical_assignments", "randomized_treatment_order", "exact_source_receipts", "cold_and_warm_runs", "paired_metrics", "pareto_comparison"],
      "properties": {
        "identical_assignments": {"const": true},
        "randomized_treatment_order": {"const": true},
        "exact_source_receipts": {"const": true},
        "cold_and_warm_runs": {"const": true},
        "paired_metrics": {"const": true},
        "pareto_comparison": {"const": "candidate-vs-honey-and-champion"}
      }
    },
    "content_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only", "aggregate_hidden_partitions", "raw_content_in_receipts", "secret_values", "tenant_content"],
      "properties": {
        "synthetic_only": {"const": true},
        "aggregate_hidden_partitions": {"const": true},
        "raw_content_in_receipts": {"const": false},
        "secret_values": {"const": false},
        "tenant_content": {"const": false}
      }
    }
  },
  "$defs": {
    "repositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 512},
        "source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"}
      }
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "repository_role", "path", "sha256", "bytes"],
      "properties": {
        "artifact_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "repository_role": {"enum": ["humidor", "cedar"]},
        "path": {"$ref": "common-v1.schema.json#/$defs/path"},
        "sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kernel_strata", "downstream_coverage", "required"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "kernel_strata": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        },
        "downstream_coverage": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        },
        "required": {"const": true}
      }
    }
  }
}
