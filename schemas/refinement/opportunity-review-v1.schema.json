{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/opportunity-review-v1.schema.json",
  "$defs": {
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "decision", "reason"],
      "properties": {
        "candidate_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
        "decision": {"enum": ["accept", "reject"]},
        "reason": {"$ref": "common-v1.schema.json#/$defs/nullableShortText"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "key_fingerprint", "mac"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "key_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "key_fingerprint": {"$ref": "common-v1.schema.json#/$defs/multihash"},
        "mac": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "candidate_set_id", "producer_id", "reviewer_id", "dispositions", "attestation"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-opportunity-review.v1"},
    "review_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "candidate_set_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "producer_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "reviewer_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "dispositions": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/disposition"}},
    "attestation": {"$ref": "#/$defs/attestation"}
  }
}
