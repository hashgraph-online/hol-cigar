{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/corpus-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "corpus_version", "partition", "disclosure", "generated_by", "task_count", "stratum_counts", "records", "packs", "annotation_policy", "license_allowlist", "qualification", "integrity"],
  "properties": {
    "schema_version": {"const": "cigar.corpus-manifest.v1"},
    "manifest_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "corpus_version": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "partition": {"enum": ["development", "shadow", "sealed"]},
    "disclosure": {"enum": ["public-records", "commitments-only"]},
    "generated_by": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "task_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "stratum_counts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stratum", "count"],
        "properties": {
          "stratum": {"$ref": "common-v1.schema.json#/$defs/identifier"},
          "count": {"type": "integer", "minimum": 1, "maximum": 10000}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opaque_task_id", "stratum", "source_commitment", "lineage_commitment", "normalized_prompt_digest", "critical_evidence_digest", "postcondition_digest", "overlap_fingerprint"],
        "properties": {
          "opaque_task_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "stratum": {"$ref": "common-v1.schema.json#/$defs/identifier"},
          "source_commitment": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "lineage_commitment": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "normalized_prompt_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "critical_evidence_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "postcondition_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "overlap_fingerprint": {"$ref": "common-v1.schema.json#/$defs/multihash"}
        }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "digest", "bytes", "custody", "reference"],
        "properties": {
          "role": {"enum": ["tasks", "prompts", "oracles", "fixtures", "annotations", "qualification"]},
          "digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
          "custody": {"enum": ["repository-public", "external-owner-only"]},
          "reference": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "common-v1.schema.json#/$defs/path"}
            ]
          }
        }
      }
    },
    "annotation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_reviewers", "resolver_required", "agreement_threshold_ppm", "treatment_blinded"],
      "properties": {
        "independent_reviewers": {"type": "integer", "minimum": 2, "maximum": 16},
        "resolver_required": {"type": "boolean"},
        "agreement_threshold_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "treatment_blinded": {"type": "boolean"}
      }
    },
    "license_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified_tasks", "quarantined_tasks", "agreement_ppm", "setup_smoke_passed", "postcondition_smoke_passed", "selection_runs"],
      "properties": {
        "qualified_tasks": {"type": "integer", "minimum": 0, "maximum": 10000},
        "quarantined_tasks": {"type": "integer", "minimum": 0, "maximum": 10000},
        "agreement_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "setup_smoke_passed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "postcondition_smoke_passed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "selection_runs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "tasks", "technically_executable", "critical_recall_ppm", "precision_ppm", "selection_digest"],
            "properties": {
              "selector": {"enum": ["baseline-all-authorized-v1", "cigar-lexical-v1", "human-oracle-v1"]},
              "tasks": {"type": "integer", "minimum": 1, "maximum": 10000},
              "technically_executable": {"type": "boolean"},
              "critical_recall_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "precision_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "selection_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"}
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "digest_bound", "partition_disjoint", "licenses_allowed", "canaries_unique", "contamination_clear", "proposal_boundary_clear"],
      "properties": {
        "canonical": {"type": "boolean"},
        "digest_bound": {"type": "boolean"},
        "partition_disjoint": {"type": "boolean"},
        "licenses_allowed": {"type": "boolean"},
        "canaries_unique": {"type": "boolean"},
        "contamination_clear": {"type": "boolean"},
        "proposal_boundary_clear": {"type": "boolean"}
      }
    }
  }
}
