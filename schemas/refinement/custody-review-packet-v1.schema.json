{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/custody-review-packet-v1.schema.json",
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "common-v1.schema.json#/$defs/path"},
        "sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "status": {"const": "passed"},
        "evidence": {"$ref": "common-v1.schema.json#/$defs/shortText"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "source", "source_clean", "workflow_audit_id", "assets", "checks", "required_reviewer_assertions", "contains_private_content", "review_status"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-custody-review-packet.v1"},
    "packet_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
    "source_clean": {"type": "boolean"},
    "workflow_audit_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "assets": {
      "type": "array",
      "minItems": 10,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/asset"}
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/check"}
    },
    "required_reviewer_assertions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 32,
      "items": {"$ref": "common-v1.schema.json#/$defs/shortText"}
    },
    "contains_private_content": {"const": false},
    "review_status": {"const": "awaiting-independent-review"}
  }
}
