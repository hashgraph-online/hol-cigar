{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/downstream-nomination-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nomination_id",
    "trial_id",
    "decision",
    "evidence_class",
    "champion_source",
    "candidate_source",
    "ledger_entry_id",
    "loop_event_id",
    "changed_paths",
    "downstream_gate_required",
    "experimental_profile",
    "operation",
    "merge_authority",
    "publication_authority",
    "contains_private_content",
    "attestation"
  ],
  "properties": {
    "schema_version": {"const": "cigar.refinement-downstream-nomination.v1"},
    "nomination_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "trial_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "decision": {"const": "nominate"},
    "evidence_class": {"enum": ["development", "shadow", "promotion"]},
    "champion_source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
    "candidate_source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
    "ledger_entry_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "loop_event_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "surfaces"],
        "properties": {
          "path": {"$ref": "common-v1.schema.json#/$defs/path"},
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": [
                "internal",
                "public-profile",
                "abi",
                "sdk",
                "storage",
                "effects",
                "replay",
                "release-artifact"
              ]
            }
          }
        }
      }
    },
    "downstream_gate_required": {"type": "boolean"},
    "experimental_profile": {"type": "boolean"},
    "operation": {"const": "request-humidor-qualification"},
    "merge_authority": {"const": false},
    "publication_authority": {"const": false},
    "contains_private_content": {"const": false},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "key_fingerprint", "custody", "mac"],
      "properties": {
        "algorithm": {"const": "hmac-sha256-v1"},
        "key_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "key_fingerprint": {"$ref": "common-v1.schema.json#/$defs/multihash"},
        "custody": {"const": "external-independent"},
        "mac": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
