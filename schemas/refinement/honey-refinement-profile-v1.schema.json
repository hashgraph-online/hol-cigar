{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/honey-refinement-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "target",
    "frozen_sources",
    "candidate_policy",
    "scope",
    "frozen_contract",
    "hard_invariants",
    "evaluation",
    "cycles",
    "promotion_thresholds",
    "deferred_work",
    "human_breakpoints",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "cigar.honey-refinement-profile.v1"},
    "profile_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_version", "release_target", "channel", "evidence_class", "platform", "topology"],
      "properties": {
        "candidate_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "release_target": {"type": "string", "minLength": 1, "maxLength": 64},
        "channel": {"const": "honey"},
        "evidence_class": {"const": "development"},
        "platform": {"const": "macos-arm64"},
        "topology": {"const": "host-native-local-sidecar"}
      }
    },
    "frozen_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_honey", "champion"],
      "properties": {
        "published_honey": {"$ref": "#/$defs/frozenSource"},
        "champion": {"$ref": "#/$defs/frozenSource"}
      }
    },
    "candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "branch_pattern", "descendant_required", "isolated_worktree_required", "champion_replacement_rule", "final_signed_source_rule"],
      "properties": {
        "base": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
        "branch_pattern": {"type": "string", "minLength": 1, "maxLength": 256},
        "descendant_required": {"const": true},
        "isolated_worktree_required": {"const": true},
        "champion_replacement_rule": {"const": "pareto-superior-only"},
        "final_signed_source_rule": {"const": "qualify-after-private-merge"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_components", "frozen_paths", "external_responsibilities"],
      "properties": {
        "allowed_components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/component"}
        },
        "frozen_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/path"}
        },
        "external_responsibilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        }
      }
    },
    "frozen_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_abi", "protocol_minimum", "protocol_maximum", "public_v1_operations", "public_v1_payloads", "balanced_v1_compatibility", "breaking_changes_allowed"],
      "properties": {
        "context_abi": {"const": "cigar.context.v1"},
        "protocol_minimum": {"const": "1.0"},
        "protocol_maximum": {"const": "1.x"},
        "public_v1_operations": {"const": 45},
        "public_v1_payloads": {"const": 70},
        "balanced_v1_compatibility": {"const": true},
        "breaking_changes_allowed": {"const": false}
      }
    },
    "hard_invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/invariant"}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort", "promotion_policy", "efficiency_profile", "identical_inputs_required", "three_treatments_required", "content_safe_receipts_required"],
      "properties": {
        "cohort": {"$ref": "common-v1.schema.json#/$defs/artifactReference"},
        "promotion_policy": {"$ref": "common-v1.schema.json#/$defs/artifactReference"},
        "efficiency_profile": {"$ref": "common-v1.schema.json#/$defs/artifactReference"},
        "identical_inputs_required": {"const": true},
        "three_treatments_required": {"const": true},
        "content_safe_receipts_required": {"const": true}
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/cycle"}
    },
    "promotion_thresholds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/threshold"}
    },
    "deferred_work": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
    },
    "human_breakpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/breakpoint"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create_private_draft_pull_request", "approve", "merge", "tag", "release", "publish", "deploy", "push_public"],
      "properties": {
        "create_private_draft_pull_request": {"const": true},
        "approve": {"const": false},
        "merge": {"const": true},
        "tag": {"const": false},
        "release": {"const": false},
        "publish": {"const": false},
        "deploy": {"const": false},
        "push_public": {"const": false}
      }
    }
  },
  "$defs": {
    "frozenSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "source", "tag", "immutable"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 512},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
        "tag": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 128}
          ]
        },
        "immutable": {"const": true}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "objectives", "activation", "maximum_files", "maximum_lines"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/path"}
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        },
        "activation": {"enum": ["measured-gap-only", "hard-invariant-correction-only"]},
        "maximum_files": {"type": "integer", "minimum": 1, "maximum": 24},
        "maximum_lines": {"type": "integer", "minimum": 1, "maximum": 2000}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "failure_effect"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "source": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "failure_effect": {"const": "reject-candidate"}
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "purpose", "allowed_change_class", "maximum_product_hypotheses", "entry_gate", "exit_gate"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
        "id": {"enum": ["cycle-a", "cycle-b", "cycle-c"]},
        "purpose": {"$ref": "common-v1.schema.json#/$defs/shortText"},
        "allowed_change_class": {"enum": ["measurement-harness-only", "targeted-product-improvement", "resilience-and-regression-only"]},
        "maximum_product_hypotheses": {"type": "integer", "minimum": 0, "maximum": 3},
        "entry_gate": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "exit_gate": {"$ref": "common-v1.schema.json#/$defs/identifier"}
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "value", "unit", "scope"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "operator": {"enum": ["exactly", "at-least", "at-most", "less-than", "nonnegative", "unchanged", "all-pass"]},
        "value": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1000000000000000},
            {"type": "string", "minLength": 1, "maxLength": 128}
          ]
        },
        "unit": {"enum": ["ratio", "percent", "milliseconds-per-request", "seconds", "bytes-per-compilation", "count", "status"]},
        "scope": {"enum": ["global", "global-and-workflow", "workflow", "protected-stratum", "protocol"]}
      }
    },
    "breakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "required_before", "automation_may_continue_without_approval"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 32},
        "id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "required_before": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "automation_may_continue_without_approval": {"const": false}
      }
    }
  }
}
