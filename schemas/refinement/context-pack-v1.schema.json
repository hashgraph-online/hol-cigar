{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/context-pack-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "task_packet_id", "prompt_digests", "resources"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-context-pack.v1"},
    "pack_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "task_packet_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "prompt_digests": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/multihash"}},
    "resources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": {"$ref": "common-v1.schema.json#/$defs/identifier"},
          "sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}
        }
      }
    }
  }
}
