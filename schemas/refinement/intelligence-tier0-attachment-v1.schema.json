{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/intelligence-tier0-attachment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attachment_id", "plan_id", "build_set_id", "manifest_id", "gate_evidence_id", "evaluation_ids_digest", "pair_ids_digest", "sources", "consumer_digests", "checks", "status"],
  "properties": {
    "schema_version": {"const": "cigar.intelligence-tier0-attachment.v1"},
    "attachment_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "plan_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "build_set_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "manifest_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "gate_evidence_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "evaluation_ids_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "pair_ids_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "sources": {"$ref": "intelligence-profile-qualification-v1.schema.json#/properties/sources"},
    "consumer_digests": {"$ref": "intelligence-profile-qualification-v1.schema.json#/properties/consumer_digests"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "evidence_digest"],
        "properties": {
          "check_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
          "evidence_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"}
        }
      }
    },
    "status": {"const": "passed"}
  }
}
