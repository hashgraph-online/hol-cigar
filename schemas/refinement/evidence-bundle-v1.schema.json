{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/evidence-bundle-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "run_id", "evidence_class", "authority", "policy_id", "retention_days", "source", "attachments"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-evidence-bundle.v1"},
    "bundle_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "run_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "evidence_class": {"$ref": "common-v1.schema.json#/$defs/evidenceClass"},
    "authority": {"enum": ["diagnostic-only", "development-only", "shadow-nomination", "promotion-preparation"]},
    "policy_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 400},
    "source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
    "attachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"$ref": "common-v1.schema.json#/$defs/path"},
          "sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 68719476736}
        }
      }
    }
  }
}
