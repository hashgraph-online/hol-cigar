{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/operations-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "providers", "global", "retention_days"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-operations-policy.v1"},
    "policy_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "max_input_tokens_per_day", "max_output_tokens_per_day", "max_cost_microusd_per_day", "max_concurrent_reservations"],
        "properties": {
          "provider_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
          "max_input_tokens_per_day": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
          "max_output_tokens_per_day": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
          "max_cost_microusd_per_day": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
          "max_concurrent_reservations": {"type": "integer", "minimum": 1, "maximum": 1024}
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_compute_milliseconds_per_day", "max_concurrent_reservations"],
      "properties": {
        "max_compute_milliseconds_per_day": {"type": "integer", "minimum": 1, "maximum": 604800000},
        "max_concurrent_reservations": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "retention_days": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic", "development", "shadow", "promotion"],
      "properties": {
        "diagnostic": {"type": "integer", "minimum": 1, "maximum": 400},
        "development": {"type": "integer", "minimum": 1, "maximum": 400},
        "shadow": {"type": "integer", "minimum": 1, "maximum": 400},
        "promotion": {"type": "integer", "minimum": 1, "maximum": 400}
      }
    }
  }
}
