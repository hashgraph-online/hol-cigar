{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/workflow-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "workflows"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-workflow-policy.v1"},
    "policy_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "workflows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "triggers", "authority", "environment", "allowed_secret_handles", "retention_days", "max_timeout_minutes"],
        "properties": {
          "filename": {"type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-z0-9-]+\\.yml$"},
          "triggers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"enum": ["pull_request", "schedule", "workflow_dispatch"]}
          },
          "authority": {"enum": ["diagnostic", "development", "shadow", "promotion"]},
          "environment": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^refinement-[a-z-]+$"}
            ]
          },
          "allowed_secret_handles": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"}
          },
          "retention_days": {"type": "integer", "minimum": 1, "maximum": 400},
          "max_timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 1440}
        }
      }
    }
  }
}
