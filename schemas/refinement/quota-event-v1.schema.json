{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/quota-event-v1.schema.json",
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost_microusd", "compute_milliseconds"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "compute_milliseconds": {"type": "integer", "minimum": 0, "maximum": 604800000}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "previous_event_id", "policy_id", "kind", "reservation_id", "utc_day", "provider_id", "requested", "actual"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-quota-event.v1"},
    "event_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "previous_event_id": {"$ref": "common-v1.schema.json#/$defs/nullableMultihash"},
    "policy_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "kind": {"enum": ["reserved", "settled", "cancelled"]},
    "reservation_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "utc_day": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "provider_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "requested": {"$ref": "#/$defs/resources"},
    "actual": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/resources"}
      ]
    }
  }
}
