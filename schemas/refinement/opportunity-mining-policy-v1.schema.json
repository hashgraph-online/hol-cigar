{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/opportunity-mining-policy-v1.schema.json",
  "$defs": {
    "signalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_metric", "owner_hint", "strata", "estimated_cost"],
      "properties": {
        "signal_metric": {"$ref": "common-v1.schema.json#/$defs/shortText"},
        "owner_hint": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "strata": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
        },
        "estimated_cost": {"type": "number", "minimum": 0.000001, "maximum": 1000000}
      }
    },
    "kpiRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "source_metric", "direction", "minimum_regression_ppm", "full_scale_ppm", "target"],
      "properties": {
        "rule_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "source_metric": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "direction": {"enum": ["higher", "lower"]},
        "minimum_regression_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
        "full_scale_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
        "target": {"$ref": "#/$defs/signalTarget"}
      }
    },
    "failureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "failure_class", "minimum_count", "full_scale_count", "target"],
      "properties": {
        "rule_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "failure_class": {"$ref": "common-v1.schema.json#/$defs/shortText"},
        "minimum_count": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "full_scale_count": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "target": {"$ref": "#/$defs/signalTarget"}
      }
    },
    "paretoRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "objective", "direction", "goal", "minimum_gap", "full_scale_gap", "target"],
      "properties": {
        "rule_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "objective": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "direction": {"enum": ["higher", "lower"]},
        "goal": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000},
        "minimum_gap": {"type": "number", "minimum": 0.000000001, "maximum": 1000000000000000},
        "full_scale_gap": {"type": "number", "minimum": 0.000000001, "maximum": 1000000000000000},
        "target": {"$ref": "#/$defs/signalTarget"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "producer_id", "kpi_lookback", "kpi_rules", "failure_rules", "pareto_rules"],
  "properties": {
    "schema_version": {"const": "cigar.refinement-opportunity-mining-policy.v1"},
    "policy_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "producer_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "kpi_lookback": {"type": "integer", "minimum": 1, "maximum": 10000},
    "kpi_rules": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/kpiRule"}},
    "failure_rules": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/failureRule"}},
    "pareto_rules": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/paretoRule"}}
  }
}
