{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/honey-treatment-failure-evaluation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "task_id", "task_lineage_id", "stratum", "seed_index", "treatment", "profile_id", "manifest_id", "source", "assignment_digest", "consumer_digest", "failure", "metrics", "attestation"],
  "properties": {
    "schema_version": {"const": "cigar.honey-treatment-failure-evaluation.v1"},
    "evaluation_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "task_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "task_lineage_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "stratum": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "seed_index": {"type": "integer", "minimum": 0, "maximum": 15},
    "treatment": {"enum": ["honey", "champion", "candidate"]},
    "profile_id": {"enum": ["balanced.v1", "balanced.v2-candidate.1", "balanced.v2-candidate.2", "balanced.v3"]},
    "manifest_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
    "assignment_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "consumer_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "failure": {"$ref": "benchmark-three-way-v1.schema.json#/$defs/failure"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "intelligence-profile-evaluation-v1.schema.json#/$defs/metric"}
    },
    "attestation": {"$ref": "intelligence-profile-evaluation-v1.schema.json#/$defs/attestation"}
  }
}
