{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/intelligence-gate-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "purpose", "gate_id", "source", "plan_id", "build_set_id", "policy_digest", "command_results", "attachment_digests", "status", "attestation"],
  "properties": {
    "schema_version": {"const": "cigar.intelligence-gate-receipt.v1"},
    "receipt_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "purpose": {"const": "private-candidate-tier1-gate"},
    "gate_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "source": {"$ref": "common-v1.schema.json#/$defs/sourceIdentity"},
    "plan_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "build_set_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "policy_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "command_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "command_sha256", "tool_digest", "result_id", "exit_code", "timed_out", "output_overflow", "stdout_bytes", "stdout_sha256", "stderr_bytes", "stderr_sha256", "status"],
        "properties": {
          "command_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
          "command_sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
          "tool_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "result_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
          "exit_code": {"const": 0},
          "timed_out": {"const": false},
          "output_overflow": {"const": false},
          "stdout_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "stdout_sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
          "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "stderr_sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
          "status": {"const": "passed"}
        }
      }
    },
    "attachment_digests": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common-v1.schema.json#/$defs/multihash"}
    },
    "status": {"const": "passed"},
    "attestation": {"$ref": "intelligence-profile-evaluation-v1.schema.json#/$defs/attestation"}
  }
}
