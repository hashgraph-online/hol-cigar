{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/refinement/honey-three-way-execution-attachment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attachment_id", "plan_id", "build_set_id", "manifest_id", "key_fingerprint", "evaluation_ids_digest", "run_ids_digest", "evaluations", "runs", "tier0_checks", "status"],
  "properties": {
    "schema_version": {"const": "cigar.honey-three-way-execution-attachment.v1"},
    "attachment_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "plan_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "build_set_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "manifest_id": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "key_fingerprint": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "evaluation_ids_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "run_ids_digest": {"$ref": "common-v1.schema.json#/$defs/multihash"},
    "evaluations": {"type": "integer", "minimum": 108, "maximum": 12960},
    "runs": {"type": "integer", "minimum": 36, "maximum": 4320},
    "tier0_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}
    },
    "status": {"const": "passed"}
  }
}
