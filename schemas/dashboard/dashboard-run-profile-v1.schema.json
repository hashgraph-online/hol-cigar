{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.dev/schemas/dashboard/dashboard-run-profile-v1.schema.json",
  "title": "CIGAR dashboard reviewed run profile registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "profiles"],
  "properties": {
    "schema_version": {"const": "cigar.dashboard-run-profile-registry.v1"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/Profile"}
    }
  },
  "$defs": {
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "kind", "executable", "argv", "working_directory", "availability_state", "availability_probes", "platforms", "control_required", "expected_duration_seconds", "maximum_duration_seconds", "resource_ceiling", "network_mode", "concurrency_group", "cancellation_grace_seconds", "receipt_schema", "evidence_category", "documentation"],
      "properties": {
        "id": {"$ref": "common-v1.schema.json#/$defs/BoundedIdentifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "kind": {"enum": ["check", "matrix", "demo", "benchmark", "soak"]},
        "executable": {"enum": ["cargo", "python3", "cigar-soak"]},
        "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "working_directory": {"enum": ["workspace", "isolated_sandbox", "installed_candidate"]},
        "availability_state": {"enum": ["available", "command_not_implemented"]},
        "availability_probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "selector"],
            "properties": {
              "kind": {"enum": ["executable", "workspace_path", "cargo_cache", "installed_candidate"]},
              "selector": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        },
        "platforms": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["linux", "macos", "windows"]}},
        "control_required": {"type": "boolean"},
        "expected_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "maximum_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "resource_ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory_mib", "output_bytes", "evidence_bytes", "processes"],
          "properties": {
            "memory_mib": {"type": "integer", "minimum": 64, "maximum": 65536},
            "output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
            "evidence_bytes": {"type": "integer", "minimum": 1024, "maximum": 10737418240},
            "processes": {"type": "integer", "minimum": 1, "maximum": 1024}
          }
        },
        "network_mode": {"enum": ["offline", "loopback", "declared_external"]},
        "concurrency_group": {"$ref": "common-v1.schema.json#/$defs/BoundedIdentifier"},
        "cancellation_grace_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "receipt_schema": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_category": {"enum": ["development", "candidate", "installed", "release"]},
        "documentation": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
