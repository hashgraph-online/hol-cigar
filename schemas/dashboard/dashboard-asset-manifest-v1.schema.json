{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.dev/schemas/dashboard/dashboard-asset-manifest-v1.schema.json",
  "title": "CIGAR dashboard static asset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": {"const": "cigar.dashboard-asset-manifest.v1"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "media_type"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
          "size": {"type": "integer", "minimum": 1, "maximum": 16777216},
          "media_type": {
            "enum": [
              "text/html; charset=utf-8",
              "text/javascript; charset=utf-8",
              "text/css; charset=utf-8",
              "application/json",
              "image/svg+xml",
              "image/png",
              "font/woff2"
            ]
          }
        }
      }
    }
  }
}
