{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.dev/schemas/dashboard/dashboard-supervisor-receipt-v1.schema.json",
  "title": "CIGAR dashboard supervisor receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["argv_sha256", "dashboard_sha256", "environment_sha256", "executable_sha256", "execution_inputs", "exit_code", "finished_at", "monotonic_elapsed_ns", "profile_id", "profile_sha256", "registry_sha256", "run_id", "schema_version", "source_clean", "source_revision", "source_tree_sha256", "started_at", "stderr", "stdout", "stop_reason", "tool_version_sha256"],
  "properties": {
    "argv_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "dashboard_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "environment_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "executable_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "execution_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/executionInput"}
    },
    "exit_code": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
    "finished_at": {"$ref": "common-v1.schema.json#/$defs/UtcTimestamp"},
    "monotonic_elapsed_ns": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
    "profile_id": {"$ref": "common-v1.schema.json#/$defs/BoundedIdentifier"},
    "profile_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "registry_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "run_id": {"$ref": "common-v1.schema.json#/$defs/UuidV7"},
    "schema_version": {"const": "cigar.dashboard-supervisor-receipt.v1"},
    "source_clean": {"const": true},
    "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "source_tree_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "started_at": {"$ref": "common-v1.schema.json#/$defs/UtcTimestamp"},
    "stderr": {"$ref": "#/$defs/stream"},
    "stdout": {"$ref": "#/$defs/stream"},
    "stop_reason": {"enum": ["exited", "cancelled", "timed_out", "resource_limit"]},
    "tool_version_sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "resource_violation": {"enum": ["memory", "process_count", "probe"]}
  },
  "$defs": {
    "executionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "mode", "owner_uid", "path", "role", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "owner_uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "role": {"enum": ["executable", "profile-configuration", "python-entrypoint", "python-import", "source-input"]},
        "sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "exceeded", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1073750016},
        "exceeded": {"type": "boolean"},
        "sha256": {"$ref": "common-v1.schema.json#/$defs/Sha256"}
      }
    }
  }
}
