{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.dev/schemas/dashboard/soak-plan-v1.schema.json",
  "title": "CIGAR deterministic soak plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "profile_id", "seed", "duration_seconds", "session_schedule", "workload_weights", "faults", "source_revision", "daemon_digest", "profile_digest"],
  "properties": {
    "schema_version": {"const": "cigar.soak-plan.v1"},
    "plan_id": {"$ref": "common-v1.schema.json#/$defs/UuidV7"},
    "profile_id": {"enum": ["soak-smoke", "soak-developer", "soak-extended", "soak-rc-24h"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "duration_seconds": {"enum": [120, 900, 3600, 86400]},
    "session_schedule": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "enum": [1, 2, 4, 8, 16, 32, 64]}},
    "workload_weights": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10000}
    },
    "faults": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "at_operation", "duration_ms"],
        "properties": {
          "id": {"$ref": "common-v1.schema.json#/$defs/BoundedIdentifier"},
          "kind": {"enum": ["latency", "unavailable", "stream_disconnect", "graceful_restart", "process_kill", "index_lag", "object_failure", "key_failure", "ambiguous_effect"]},
          "at_operation": {"type": "integer", "minimum": 1},
          "duration_ms": {"type": "integer", "minimum": 0, "maximum": 300000}
        }
      }
    },
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "daemon_digest": {"$ref": "common-v1.schema.json#/$defs/Sha256"},
    "profile_digest": {"$ref": "common-v1.schema.json#/$defs/Sha256"}
  }
}
