{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextCommit",
  "description": "Immutable context-space commit.",
  "type": "object",
  "properties": {
    "author_id": {
      "description": "Authenticated author.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "commit_id": {
      "description": "Content-derived commit identity.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "committed_at": {
      "description": "Commit time.",
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "description": "Ordered immutable events.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoordinationEvent"
      },
      "maxItems": 10000,
      "minItems": 1
    },
    "extensions": {
      "description": "Stable bounded extensions.",
      "$ref": "#/$defs/ExtensionMap"
    },
    "parent_commit_id": {
      "description": "Parent commit, absent only for sequence one.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "policy_snapshot_digest": {
      "description": "Policy snapshot used for publication.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "purpose": {
      "description": "Bounded publication purpose.",
      "type": "string",
      "maxLength": 65536,
      "minLength": 1
    },
    "root_digest": {
      "description": "Resulting context-space root digest.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "schema_version": {
      "description": "Must be `cigar.context-commit.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "sequence": {
      "description": "Monotonic sequence beginning at one.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "space_id": {
      "description": "Owning context space.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_id",
    "space_id",
    "sequence",
    "author_id",
    "purpose",
    "events",
    "root_digest",
    "policy_snapshot_digest",
    "committed_at",
    "extensions"
  ],
  "$defs": {
    "CanonicalValue": {
      "description": "Canonical extension value; null and floating-point states are unrepresentable.",
      "oneOf": [
        {
          "description": "Boolean value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Signed integer value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded UTF-8 text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded byte string. JSON wire generation replaces the derived array form with base64url.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "maxLength": 87382
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Ordered values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxItems": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Deterministically ordered string-keyed values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxProperties": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "CoordinationEvent": {
      "description": "One immutable ordered event in a context commit.",
      "type": "object",
      "properties": {
        "event_id": {
          "description": "Globally unique event identity for deduplication.",
          "type": "string",
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "description": "Closed event kind.",
          "$ref": "#/$defs/CoordinationEventKind"
        },
        "payload_digest": {
          "description": "Digest of the typed event payload.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "event_id",
        "kind",
        "payload_digest"
      ]
    },
    "CoordinationEventKind": {
      "description": "Required coordination event kinds.",
      "oneOf": [
        {
          "description": "Immutable context commit was published.",
          "type": "string",
          "const": "context_committed"
        },
        {
          "description": "Atom became invalid for current selection.",
          "type": "string",
          "const": "atom_invalidated"
        },
        {
          "description": "Compiled bundle became invalid.",
          "type": "string",
          "const": "bundle_invalidated"
        },
        {
          "description": "Task checkpoint was recorded.",
          "type": "string",
          "const": "task_checkpointed"
        },
        {
          "description": "Handoff capsule was created.",
          "type": "string",
          "const": "handoff_created"
        },
        {
          "description": "Handoff was accepted.",
          "type": "string",
          "const": "handoff_accepted"
        },
        {
          "description": "Handoff was revoked.",
          "type": "string",
          "const": "handoff_revoked"
        },
        {
          "description": "Child result was proposed.",
          "type": "string",
          "const": "agent_result_proposed"
        },
        {
          "description": "Typed merge conflict was created.",
          "type": "string",
          "const": "merge_conflict_created"
        },
        {
          "description": "Effect journal state changed.",
          "type": "string",
          "const": "effect_state_changed"
        },
        {
          "description": "Policy snapshot changed.",
          "type": "string",
          "const": "policy_snapshot_changed"
        }
      ]
    },
    "ExtensionMap": {
      "description": "Deterministically ordered and bounded extension collection.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._/-]{0,127}$": {
          "$ref": "#/$defs/CanonicalValue"
        }
      }
    }
  }
}
