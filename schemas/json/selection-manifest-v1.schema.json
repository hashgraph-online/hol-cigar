{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectionManifest",
  "description": "Complete selection and exclusion explanation for a bundle.",
  "type": "object",
  "properties": {
    "contract_digest": {
      "description": "Normalized contract digest.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "entries": {
      "description": "Sorted unique entry for every considered candidate.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestEntry"
      },
      "maxItems": 10000
    },
    "extensions": {
      "description": "Stable bounded extensions.",
      "$ref": "#/$defs/ExtensionMap"
    },
    "manifest_id": {
      "description": "Content-derived manifest identity.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "schema_version": {
      "description": "Must be `cigar.selection-manifest.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "contract_digest",
    "entries",
    "extensions"
  ],
  "$defs": {
    "CandidateDisposition": {
      "description": "Deterministic disposition of one retrieval candidate.",
      "oneOf": [
        {
          "description": "Selected into a specific lane with a fixed-point score.",
          "type": "object",
          "properties": {
            "lane": {
              "description": "Selected lane.",
              "$ref": "#/$defs/LaneKind"
            },
            "score": {
              "description": "Deterministic score in millionths.",
              "type": "integer",
              "format": "uint32",
              "maximum": 1000000,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "selected"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "lane",
            "score"
          ]
        },
        {
          "description": "Excluded with a stable reason.",
          "type": "object",
          "properties": {
            "reason": {
              "description": "Primary exclusion reason.",
              "$ref": "#/$defs/DispositionReason"
            },
            "state": {
              "type": "string",
              "const": "excluded"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "description": "Redacted while preserving safe explanation that a candidate existed.",
          "type": "object",
          "properties": {
            "reason": {
              "description": "Primary redaction reason.",
              "$ref": "#/$defs/DispositionReason"
            },
            "state": {
              "type": "string",
              "const": "redacted"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "description": "Required selector had no authorized matching candidate.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "required_missing"
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        }
      ]
    },
    "CanonicalValue": {
      "description": "Canonical extension value; null and floating-point states are unrepresentable.",
      "oneOf": [
        {
          "description": "Boolean value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Signed integer value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded UTF-8 text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded byte string. JSON wire generation replaces the derived array form with base64url.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "maxLength": 87382
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Ordered values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxItems": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Deterministically ordered string-keyed values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxProperties": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "DispositionReason": {
      "description": "Stable exclusion and non-selection reason codes.",
      "oneOf": [
        {
          "description": "Candidate was outside the authorized scope.",
          "type": "string",
          "const": "scope_denied"
        },
        {
          "description": "Purpose did not authorize candidate use.",
          "type": "string",
          "const": "purpose_denied"
        },
        {
          "description": "Candidate was temporally ineligible.",
          "type": "string",
          "const": "temporal_mismatch"
        },
        {
          "description": "Candidate trust or authority was insufficient.",
          "type": "string",
          "const": "trust_insufficient"
        },
        {
          "description": "Instruction authority was insufficient.",
          "type": "string",
          "const": "instruction_authority_denied"
        },
        {
          "description": "Processor constraints were not satisfied.",
          "type": "string",
          "const": "processor_denied"
        },
        {
          "description": "Integrity verification failed.",
          "type": "string",
          "const": "integrity_failed"
        },
        {
          "description": "A higher-ranked candidate displaced this one under budget.",
          "type": "string",
          "const": "budget_displaced"
        },
        {
          "description": "Candidate was superseded or tombstoned.",
          "type": "string",
          "const": "lifecycle_ineligible"
        },
        {
          "description": "Candidate conflicted with a mandatory higher-authority item.",
          "type": "string",
          "const": "conflict_lost"
        },
        {
          "description": "Required context could not be found.",
          "type": "string",
          "const": "required_missing"
        }
      ]
    },
    "ExtensionMap": {
      "description": "Deterministically ordered and bounded extension collection.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._/-]{0,127}$": {
          "$ref": "#/$defs/CanonicalValue"
        }
      }
    },
    "LaneKind": {
      "description": "Standard deterministic context lanes.",
      "oneOf": [
        {
          "description": "Non-bypassable rules and instructions.",
          "type": "string",
          "const": "rules"
        },
        {
          "description": "Current task statement and exact constraints.",
          "type": "string",
          "const": "task"
        },
        {
          "description": "Source, documentation, and verification evidence.",
          "type": "string",
          "const": "evidence"
        },
        {
          "description": "Prior decisions and relevant history.",
          "type": "string",
          "const": "history"
        },
        {
          "description": "Tool contracts and capability descriptions.",
          "type": "string",
          "const": "tools"
        }
      ]
    },
    "ManifestEntry": {
      "description": "Complete explanation entry for one considered catalog version.",
      "type": "object",
      "properties": {
        "disposition": {
          "description": "Final deterministic disposition.",
          "$ref": "#/$defs/CandidateDisposition"
        },
        "provenance_digest": {
          "description": "Digest proving catalog-derived provenance.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        },
        "reason_codes": {
          "description": "Sorted unique supplementary reason codes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DispositionReason"
          },
          "maxItems": 64
        },
        "version_id": {
          "description": "Considered catalog version.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "version_id",
        "disposition",
        "reason_codes",
        "provenance_digest"
      ]
    }
  }
}
