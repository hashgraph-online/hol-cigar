{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityGrant",
  "description": "Attenuable capability grant; possession never bypasses current policy.",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "Sorted unique granted capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "maxItems": 128,
      "minItems": 1
    },
    "delegation_depth": {
      "description": "Remaining permitted delegation depth.",
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "expires_at": {
      "description": "Exclusive expiry instant.",
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "description": "Stable bounded extensions.",
      "$ref": "#/$defs/ExtensionMap"
    },
    "grant_id": {
      "description": "Unique grant identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer_id": {
      "description": "Principal issuing this grant.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "not_before": {
      "description": "First valid instant.",
      "type": "string",
      "format": "date-time"
    },
    "parent_grant_id": {
      "description": "Optional parent grant for delegated authority.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "processors": {
      "description": "Sorted unique processor identifiers.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 65536,
        "minLength": 1
      },
      "maxItems": 10000
    },
    "project_ids": {
      "description": "Sorted unique project scope.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "schema_version": {
      "description": "Must be `cigar.capability-grant.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "subject_id": {
      "description": "Principal receiving this grant.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "issuer_id",
    "subject_id",
    "capabilities",
    "project_ids",
    "processors",
    "not_before",
    "expires_at",
    "delegation_depth",
    "extensions"
  ],
  "$defs": {
    "CanonicalValue": {
      "description": "Canonical extension value; null and floating-point states are unrepresentable.",
      "oneOf": [
        {
          "description": "Boolean value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Signed integer value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded UTF-8 text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded byte string. JSON wire generation replaces the derived array form with base64url.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "maxLength": 87382
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Ordered values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxItems": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Deterministically ordered string-keyed values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxProperties": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "Capability": {
      "description": "Closed capabilities that may be granted and attenuated.",
      "oneOf": [
        {
          "description": "Observe authorized context records.",
          "type": "string",
          "const": "read_context"
        },
        {
          "description": "Compile an authorized context bundle.",
          "type": "string",
          "const": "compile_context"
        },
        {
          "description": "Propose private overlay mutations.",
          "type": "string",
          "const": "write_overlay"
        },
        {
          "description": "Publish an overlay through optimistic merge.",
          "type": "string",
          "const": "publish_overlay"
        },
        {
          "description": "Create a handoff capsule.",
          "type": "string",
          "const": "create_handoff"
        },
        {
          "description": "Accept a handoff capsule.",
          "type": "string",
          "const": "accept_handoff"
        },
        {
          "description": "Invoke a mediated tool.",
          "type": "string",
          "const": "invoke_tool"
        },
        {
          "description": "Propose an external effect intent.",
          "type": "string",
          "const": "propose_effect"
        },
        {
          "description": "Approve an external effect.",
          "type": "string",
          "const": "approve_effect"
        },
        {
          "description": "Reconcile an unknown effect.",
          "type": "string",
          "const": "reconcile_effect"
        }
      ]
    },
    "ExtensionMap": {
      "description": "Deterministically ordered and bounded extension collection.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._/-]{0,127}$": {
          "$ref": "#/$defs/CanonicalValue"
        }
      }
    }
  }
}
