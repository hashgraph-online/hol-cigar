{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlay",
  "description": "Private overlay over one immutable base commit.",
  "type": "object",
  "properties": {
    "base_commit_id": {
      "description": "Exact immutable merge base.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "created_at": {
      "description": "Creation time.",
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "description": "Expiry time.",
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "description": "Stable bounded extensions.",
      "$ref": "#/$defs/ExtensionMap"
    },
    "mutations": {
      "description": "Ordered proposed mutations.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/OverlayMutation"
      },
      "maxItems": 10000
    },
    "overlay_id": {
      "description": "Unique overlay identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "owner_id": {
      "description": "Principal allowed to observe and mutate this overlay.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {
      "description": "Must be `cigar.overlay.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "space_id": {
      "description": "Owning context space.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_id",
    "space_id",
    "base_commit_id",
    "owner_id",
    "created_at",
    "expires_at",
    "mutations",
    "extensions"
  ],
  "$defs": {
    "CanonicalValue": {
      "description": "Canonical extension value; null and floating-point states are unrepresentable.",
      "oneOf": [
        {
          "description": "Boolean value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Signed integer value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded UTF-8 text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded byte string. JSON wire generation replaces the derived array form with base64url.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "maxLength": 87382
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Ordered values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxItems": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Deterministically ordered string-keyed values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxProperties": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "ExtensionMap": {
      "description": "Deterministically ordered and bounded extension collection.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._/-]{0,127}$": {
          "$ref": "#/$defs/CanonicalValue"
        }
      }
    },
    "OverlayMutation": {
      "description": "Typed private overlay mutation; order is semantically significant.",
      "oneOf": [
        {
          "description": "Proposed atom version.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "atom"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed decision record.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "decision"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed task-state record.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed artifact record.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed instruction record requiring typed resolution.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "instruction"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed capability record requiring exact-base resolution.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "capability"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed lease record requiring exact-base resolution.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "lease"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        },
        {
          "description": "Proposed effect-state record requiring exact-base resolution.",
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "effect"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "digest"
          ]
        }
      ]
    }
  }
}
