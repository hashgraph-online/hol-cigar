{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextBlock",
  "description": "One packed, provenance-complete semantic block.",
  "type": "object",
  "properties": {
    "block_id": {
      "description": "Content-derived block identity.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "content_digest": {
      "description": "Exact digest of rendered block content.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "lane": {
      "description": "Destination lane.",
      "$ref": "#/$defs/LaneKind"
    },
    "provenance": {
      "description": "Sorted unique catalog versions that prove provenance.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 68,
        "minLength": 68,
        "pattern": "^1220[0-9a-f]{64}$"
      },
      "maxItems": 10000,
      "minItems": 1
    },
    "representation": {
      "description": "Representation kind.",
      "$ref": "#/$defs/RepresentationKind"
    },
    "token_count": {
      "description": "Exact physical tokens under the target tokenizer.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "transform_receipt": {
      "description": "Evidence receipt for a non-exact transform.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "block_id",
    "lane",
    "representation",
    "content_digest",
    "token_count",
    "provenance"
  ],
  "$defs": {
    "LaneKind": {
      "description": "Standard deterministic context lanes.",
      "oneOf": [
        {
          "description": "Non-bypassable rules and instructions.",
          "type": "string",
          "const": "rules"
        },
        {
          "description": "Current task statement and exact constraints.",
          "type": "string",
          "const": "task"
        },
        {
          "description": "Source, documentation, and verification evidence.",
          "type": "string",
          "const": "evidence"
        },
        {
          "description": "Prior decisions and relevant history.",
          "type": "string",
          "const": "history"
        },
        {
          "description": "Tool contracts and capability descriptions.",
          "type": "string",
          "const": "tools"
        }
      ]
    },
    "RepresentationKind": {
      "description": "Evidence-carrying representation selected for one context block.",
      "oneOf": [
        {
          "description": "Exact source content.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "Deterministically extracted source span.",
          "type": "string",
          "const": "extracted"
        },
        {
          "description": "Evidence-backed deterministic summary.",
          "type": "string",
          "const": "summarized"
        },
        {
          "description": "Redacted marker with no protected content.",
          "type": "string",
          "const": "redacted"
        }
      ]
    }
  }
}
