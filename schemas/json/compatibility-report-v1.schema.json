{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompatibilityReport",
  "description": "Protocol and schema compatibility report.",
  "type": "object",
  "properties": {
    "compatible": {
      "description": "Whether the compared peer/artifact is compatible.",
      "type": "boolean"
    },
    "protocol_max": {
      "description": "Maximum accepted protocol line.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "protocol_min": {
      "description": "Minimum accepted protocol version.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "reasons": {
      "description": "Sorted unique incompatibility reason codes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ErrorCode"
      },
      "maxItems": 256
    },
    "schema_majors": {
      "description": "Maximum supported schema major by family.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0
      },
      "maxProperties": 1024
    },
    "schema_version": {
      "description": "Must be `cigar.compatibility-report.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "writer_protocol": {
      "description": "Configured writer protocol version.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_min",
    "protocol_max",
    "writer_protocol",
    "schema_majors",
    "compatible",
    "reasons"
  ],
  "$defs": {
    "ErrorCode": {
      "description": "Stable closed public error codes. Numeric and transport mappings are frozen in `spec/errors`.",
      "oneOf": [
        {
          "description": "Caller input is structurally invalid.",
          "type": "string",
          "const": "INVALID_ARGUMENT"
        },
        {
          "description": "A named resource limit was exceeded.",
          "type": "string",
          "const": "LIMIT_EXCEEDED"
        },
        {
          "description": "Schema major or form is unsupported.",
          "type": "string",
          "const": "UNSUPPORTED_SCHEMA"
        },
        {
          "description": "Authenticated principal is unknown.",
          "type": "string",
          "const": "UNKNOWN_PRINCIPAL"
        },
        {
          "description": "Capability is malformed or insufficient.",
          "type": "string",
          "const": "INVALID_CAPABILITY"
        },
        {
          "description": "Capability is expired.",
          "type": "string",
          "const": "CAPABILITY_EXPIRED"
        },
        {
          "description": "Source connector is unavailable.",
          "type": "string",
          "const": "SOURCE_UNAVAILABLE"
        },
        {
          "description": "Source snapshot is incomplete.",
          "type": "string",
          "const": "SNAPSHOT_INCOMPLETE"
        },
        {
          "description": "Integrity verification failed.",
          "type": "string",
          "const": "INTEGRITY_FAILURE"
        },
        {
          "description": "Index watermark is stale.",
          "type": "string",
          "const": "INDEX_STALE"
        },
        {
          "description": "Required index is unavailable.",
          "type": "string",
          "const": "INDEX_UNAVAILABLE"
        },
        {
          "description": "Requested consistency could not be satisfied.",
          "type": "string",
          "const": "CONSISTENCY_UNSATISFIED"
        },
        {
          "description": "Policy denied the operation.",
          "type": "string",
          "const": "POLICY_DENIED"
        },
        {
          "description": "Processor constraints denied the operation.",
          "type": "string",
          "const": "PROCESSOR_DENIED"
        },
        {
          "description": "Instruction authority was insufficient.",
          "type": "string",
          "const": "INSTRUCTION_AUTHORITY_DENIED"
        },
        {
          "description": "Required budget cannot be satisfied.",
          "type": "string",
          "const": "BUDGET_UNSATISFIABLE"
        },
        {
          "description": "Required authorized context is missing.",
          "type": "string",
          "const": "MISSING_REQUIRED_CONTEXT"
        },
        {
          "description": "Critical semantic conflict remains unresolved.",
          "type": "string",
          "const": "UNRESOLVED_CRITICAL_CONFLICT"
        },
        {
          "description": "Delta base does not match provider-present state.",
          "type": "string",
          "const": "DELTA_BASE_MISMATCH"
        },
        {
          "description": "Bundle was invalidated.",
          "type": "string",
          "const": "BUNDLE_INVALIDATED"
        },
        {
          "description": "Optimistic revision does not match.",
          "type": "string",
          "const": "REVISION_CONFLICT"
        },
        {
          "description": "Handoff expired.",
          "type": "string",
          "const": "HANDOFF_EXPIRED"
        },
        {
          "description": "Handoff recipient does not match.",
          "type": "string",
          "const": "HANDOFF_RECIPIENT_MISMATCH"
        },
        {
          "description": "Effect requires approval.",
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "description": "Approval no longer binds current semantics or time.",
          "type": "string",
          "const": "APPROVAL_STALE"
        },
        {
          "description": "External effect outcome is unknown.",
          "type": "string",
          "const": "EFFECT_UNKNOWN"
        },
        {
          "description": "Effect cannot be safely retried.",
          "type": "string",
          "const": "UNSAFE_RETRY"
        },
        {
          "description": "Replay lacks required dependencies.",
          "type": "string",
          "const": "REPLAY_INCOMPLETE"
        },
        {
          "description": "Named dependency is unavailable.",
          "type": "string",
          "const": "DEPENDENCY_UNAVAILABLE"
        },
        {
          "description": "Live operation requires explicit new authorization.",
          "type": "string",
          "const": "LIVE_AUTHORIZATION_REQUIRED"
        },
        {
          "description": "Request rate limit was reached.",
          "type": "string",
          "const": "RATE_LIMITED"
        },
        {
          "description": "Request deadline elapsed.",
          "type": "string",
          "const": "DEADLINE_EXCEEDED"
        },
        {
          "description": "Dependency is degraded.",
          "type": "string",
          "const": "DEPENDENCY_DEGRADED"
        },
        {
          "description": "Internal error hidden behind a correlation ID.",
          "type": "string",
          "const": "INTERNAL"
        }
      ]
    }
  }
}
