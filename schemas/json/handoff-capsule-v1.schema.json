{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffCapsule",
  "description": "Signed portable handoff capsule.",
  "type": "object",
  "properties": {
    "acceptance_criteria": {
      "description": "Bounded acceptance criteria.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 65536,
        "minLength": 1
      },
      "maxItems": 10000,
      "minItems": 1
    },
    "audience": {
      "description": "Signed audience identifier.",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "budget": {
      "description": "Recipient compilation budget ceiling.",
      "$ref": "#/$defs/Budget"
    },
    "bundle_id": {
      "description": "Issuer bundle at handoff creation.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "created_at": {
      "description": "Capsule creation time.",
      "type": "string",
      "format": "date-time"
    },
    "delegated_capabilities": {
      "description": "Sorted attenuated capabilities delegated by the issuer.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "maxItems": 128
    },
    "expires_at": {
      "description": "Exclusive capsule expiry.",
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "description": "Stable bounded extensions.",
      "$ref": "#/$defs/ExtensionMap"
    },
    "handoff_id": {
      "description": "Unique capsule identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer_id": {
      "description": "Issuing principal.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer_key_id": {
      "description": "Issuer signing-key identifier.",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "nonce": {
      "description": "Replay-protection nonce encoded as unpadded base64url in JSON.",
      "type": "string",
      "maxLength": 86,
      "minLength": 2
    },
    "project_ids": {
      "description": "Sorted exact project scope.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "recipient": {
      "description": "Recipient selector and audience binding.",
      "$ref": "#/$defs/RecipientSelector"
    },
    "references": {
      "description": "Typed references; unrestricted transcript is intentionally absent.",
      "$ref": "#/$defs/HandoffReferences"
    },
    "rejected_capabilities": {
      "description": "Sorted requested capabilities rejected during creation.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "maxItems": 128
    },
    "reusable": {
      "description": "Whether multiple valid acceptances are permitted.",
      "type": "boolean"
    },
    "schema_version": {
      "description": "Must be `cigar.handoff.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "signature": {
      "description": "Ed25519 signature bytes populated by WP02.",
      "type": "string",
      "maxLength": 683,
      "minLength": 2
    },
    "task": {
      "description": "Bounded task statement.",
      "type": "string",
      "maxLength": 65536,
      "minLength": 1
    },
    "topics": {
      "description": "Sorted declared subscription topics.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoordinationTopic"
      },
      "maxItems": 32
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "issuer_id",
    "recipient",
    "task",
    "acceptance_criteria",
    "project_ids",
    "delegated_capabilities",
    "rejected_capabilities",
    "budget",
    "topics",
    "references",
    "bundle_id",
    "audience",
    "created_at",
    "expires_at",
    "nonce",
    "reusable",
    "issuer_key_id",
    "signature",
    "extensions"
  ],
  "$defs": {
    "Budget": {
      "description": "Exact integer token budget and lane allocation.",
      "type": "object",
      "properties": {
        "lane_input_tokens": {
          "description": "Exact input allocation by standard lane.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxProperties": 5,
          "minProperties": 1
        },
        "output_reserve_tokens": {
          "description": "Output tokens reserved at the target consumer.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_input_tokens": {
          "description": "Total physical input-token maximum.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "total_input_tokens",
        "output_reserve_tokens",
        "lane_input_tokens"
      ]
    },
    "CanonicalValue": {
      "description": "Canonical extension value; null and floating-point states are unrepresentable.",
      "oneOf": [
        {
          "description": "Boolean value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Signed integer value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded UTF-8 text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded byte string. JSON wire generation replaces the derived array form with base64url.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "maxLength": 87382
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Ordered values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxItems": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Deterministically ordered string-keyed values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxProperties": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "Capability": {
      "description": "Closed capabilities that may be granted and attenuated.",
      "oneOf": [
        {
          "description": "Observe authorized context records.",
          "type": "string",
          "const": "read_context"
        },
        {
          "description": "Compile an authorized context bundle.",
          "type": "string",
          "const": "compile_context"
        },
        {
          "description": "Propose private overlay mutations.",
          "type": "string",
          "const": "write_overlay"
        },
        {
          "description": "Publish an overlay through optimistic merge.",
          "type": "string",
          "const": "publish_overlay"
        },
        {
          "description": "Create a handoff capsule.",
          "type": "string",
          "const": "create_handoff"
        },
        {
          "description": "Accept a handoff capsule.",
          "type": "string",
          "const": "accept_handoff"
        },
        {
          "description": "Invoke a mediated tool.",
          "type": "string",
          "const": "invoke_tool"
        },
        {
          "description": "Propose an external effect intent.",
          "type": "string",
          "const": "propose_effect"
        },
        {
          "description": "Approve an external effect.",
          "type": "string",
          "const": "approve_effect"
        },
        {
          "description": "Reconcile an unknown effect.",
          "type": "string",
          "const": "reconcile_effect"
        }
      ]
    },
    "CoordinationTopic": {
      "description": "Closed subscription topics declared by a handoff.",
      "oneOf": [
        {
          "description": "Atom invalidation events.",
          "type": "string",
          "const": "atom_invalidation"
        },
        {
          "description": "Bundle invalidation events.",
          "type": "string",
          "const": "bundle_invalidation"
        },
        {
          "description": "Task checkpoint events.",
          "type": "string",
          "const": "task_checkpoint"
        },
        {
          "description": "Handoff revocation events.",
          "type": "string",
          "const": "handoff_revocation"
        },
        {
          "description": "Effect state changes.",
          "type": "string",
          "const": "effect_state"
        },
        {
          "description": "Policy snapshot changes.",
          "type": "string",
          "const": "policy_snapshot"
        }
      ]
    },
    "ExtensionMap": {
      "description": "Deterministically ordered and bounded extension collection.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._/-]{0,127}$": {
          "$ref": "#/$defs/CanonicalValue"
        }
      }
    },
    "HandoffReferences": {
      "description": "Typed references carried by a handoff instead of a parent transcript.",
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Sorted artifact references.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^1220[0-9a-f]{64}$"
          },
          "maxItems": 10000
        },
        "decisions": {
          "description": "Sorted decision references.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^1220[0-9a-f]{64}$"
          },
          "maxItems": 10000
        },
        "effects": {
          "description": "Sorted effect journal record references.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^1220[0-9a-f]{64}$"
          },
          "maxItems": 10000
        },
        "sources": {
          "description": "Sorted source version references.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^1220[0-9a-f]{64}$"
          },
          "maxItems": 10000
        },
        "states": {
          "description": "Sorted task-state references.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^1220[0-9a-f]{64}$"
          },
          "maxItems": 10000
        },
        "uncertainties": {
          "description": "Sorted uncertainty references.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 68,
            "minLength": 68,
            "pattern": "^1220[0-9a-f]{64}$"
          },
          "maxItems": 10000
        }
      },
      "additionalProperties": false,
      "required": [
        "sources",
        "states",
        "decisions",
        "artifacts",
        "uncertainties",
        "effects"
      ]
    },
    "RecipientSelector": {
      "description": "Recipient selector bound into a handoff capsule.",
      "oneOf": [
        {
          "description": "Exact recipient principal.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "principal"
            },
            "value": {
              "type": "string",
              "maxLength": 36,
              "minLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded recipient role resolved again during acceptance.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "role"
            },
            "value": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    }
  }
}
