{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextContract",
  "description": "Canonical normalized input to deterministic context compilation.",
  "type": "object",
  "properties": {
    "budget": {
      "description": "Exact input and output budget.",
      "$ref": "#/$defs/Budget"
    },
    "consistency": {
      "description": "Catalog/index consistency mode.",
      "$ref": "#/$defs/ConsistencyMode"
    },
    "context_space_id": {
      "description": "Context space when compiling from a branch or overlay.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "extensions": {
      "description": "Stable bounded extensions.",
      "$ref": "#/$defs/ExtensionMap"
    },
    "job_goal": {
      "description": "Human job goal; normalized before this record is hashed.",
      "type": "string",
      "maxLength": 65536,
      "minLength": 1
    },
    "maximum_staleness": {
      "description": "Maximum permitted staleness for bounded-staleness mode only.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "maximum": 315576000000000000,
      "minimum": 0
    },
    "operation_class": {
      "description": "Capability-relevant operation class.",
      "$ref": "#/$defs/OperationClass"
    },
    "principal_id": {
      "description": "Authenticated principal identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_ids": {
      "description": "Sorted unique project scope; may be empty only with a context space.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "maxItems": 256
    },
    "purpose": {
      "description": "Declared use purpose.",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "requirements": {
      "description": "Required semantic context selectors.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextRequirement"
      },
      "maxItems": 1024
    },
    "schema_version": {
      "description": "Must be `cigar.context-contract.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "target": {
      "description": "Target consumer compatibility profile.",
      "$ref": "#/$defs/TargetProfile"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_goal",
    "operation_class",
    "principal_id",
    "purpose",
    "project_ids",
    "target",
    "budget",
    "requirements",
    "consistency",
    "extensions"
  ],
  "$defs": {
    "AtomKind": {
      "description": "Closed semantic atom kind registry for v1.",
      "oneOf": [
        {
          "description": "Governed instruction content.",
          "type": "string",
          "const": "instruction"
        },
        {
          "description": "Exact source code.",
          "type": "string",
          "const": "source_code"
        },
        {
          "description": "Human-facing documentation.",
          "type": "string",
          "const": "documentation"
        },
        {
          "description": "Durable decision or rationale.",
          "type": "string",
          "const": "decision"
        },
        {
          "description": "Conversation-derived context.",
          "type": "string",
          "const": "conversation"
        },
        {
          "description": "Tool observation or result.",
          "type": "string",
          "const": "tool_result"
        },
        {
          "description": "Machine-readable schema.",
          "type": "string",
          "const": "schema"
        },
        {
          "description": "Policy source material.",
          "type": "string",
          "const": "policy"
        },
        {
          "description": "Test or verification material.",
          "type": "string",
          "const": "test"
        },
        {
          "description": "Build or release artifact metadata.",
          "type": "string",
          "const": "artifact"
        }
      ]
    },
    "Budget": {
      "description": "Exact integer token budget and lane allocation.",
      "type": "object",
      "properties": {
        "lane_input_tokens": {
          "description": "Exact input allocation by standard lane.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxProperties": 5,
          "minProperties": 1
        },
        "output_reserve_tokens": {
          "description": "Output tokens reserved at the target consumer.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_input_tokens": {
          "description": "Total physical input-token maximum.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "total_input_tokens",
        "output_reserve_tokens",
        "lane_input_tokens"
      ]
    },
    "CanonicalValue": {
      "description": "Canonical extension value; null and floating-point states are unrepresentable.",
      "oneOf": [
        {
          "description": "Boolean value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Signed integer value.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded UTF-8 text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Bounded byte string. JSON wire generation replaces the derived array form with base64url.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "maxLength": 87382
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Ordered values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxItems": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Deterministically ordered string-keyed values.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/CanonicalValue"
              },
              "maxProperties": 256
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "ConsistencyMode": {
      "description": "Closed catalog/index consistency modes.",
      "oneOf": [
        {
          "description": "Require the requested immutable snapshot exactly.",
          "type": "string",
          "const": "snapshot"
        },
        {
          "description": "Require indexes caught up to the current catalog watermark.",
          "type": "string",
          "const": "strong"
        },
        {
          "description": "Permit bounded index staleness described by the contract.",
          "type": "string",
          "const": "bounded_staleness"
        }
      ]
    },
    "ContextRequirement": {
      "description": "One semantic context requirement in a compilation contract.",
      "type": "object",
      "properties": {
        "blocking": {
          "description": "Whether missing authorized data blocks compilation.",
          "type": "boolean"
        },
        "maximum_age": {
          "description": "Maximum observation age when temporal selection applies.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 315576000000000000,
          "minimum": 0
        },
        "minimum_authority": {
          "description": "Minimum accepted authority tier.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minimum_coverage": {
          "description": "Minimum fixed-point source coverage.",
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 0
        },
        "selector": {
          "description": "Exact or retrieval selector.",
          "$ref": "#/$defs/RequirementSelector"
        },
        "semantic_type": {
          "description": "Required semantic atom kind.",
          "$ref": "#/$defs/AtomKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "semantic_type",
        "selector",
        "minimum_authority",
        "minimum_coverage",
        "blocking"
      ]
    },
    "ExtensionMap": {
      "description": "Deterministically ordered and bounded extension collection.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._/-]{0,127}$": {
          "$ref": "#/$defs/CanonicalValue"
        }
      }
    },
    "OperationClass": {
      "description": "Closed operation classes used by capability and policy gates.",
      "oneOf": [
        {
          "description": "Read-only context use.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Local source or artifact modification.",
          "type": "string",
          "const": "code_change"
        },
        {
          "description": "Analysis that must not dispatch mutations.",
          "type": "string",
          "const": "analysis"
        },
        {
          "description": "Operation that may request a mediated external effect.",
          "type": "string",
          "const": "external_mutation"
        }
      ]
    },
    "RequirementSelector": {
      "description": "Exact or query selector for required semantic context.",
      "oneOf": [
        {
          "description": "Require one exact immutable semantic version.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "exact"
            },
            "value": {
              "type": "string",
              "maxLength": 68,
              "minLength": 68,
              "pattern": "^1220[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Execute a bounded authorized retrieval query.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "query"
            },
            "value": {
              "type": "string",
              "maxLength": 16384,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "TargetProfile": {
      "description": "Consumer, tokenizer, and materializer compatibility target.",
      "type": "object",
      "properties": {
        "materializer_fingerprint": {
          "description": "Immutable materializer implementation fingerprint.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        },
        "max_context_tokens": {
          "description": "Target context-window maximum.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model_family": {
          "description": "Model or consumer family identifier.",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "provider": {
          "description": "Provider family identifier.",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "tokenizer_fingerprint": {
          "description": "Immutable tokenizer implementation fingerprint.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model_family",
        "tokenizer_fingerprint",
        "materializer_fingerprint",
        "max_context_tokens"
      ]
    }
  }
}
