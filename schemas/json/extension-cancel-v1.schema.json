{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionCancelV1",
  "description": "Idempotent cancellation message for one extension invocation.",
  "type": "object",
  "properties": {
    "cancel_id": {
      "description": "Unique cancellation record identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invocation_id": {
      "description": "Invocation being cancelled.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": {
      "description": "Safe closed cancellation reason.",
      "$ref": "#/$defs/ExtensionCancelReason"
    },
    "requested_at": {
      "description": "Cancellation request time.",
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "description": "Must be `cigar.extension-cancel.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cancel_id",
    "invocation_id",
    "reason",
    "requested_at"
  ],
  "$defs": {
    "ExtensionCancelReason": {
      "description": "Closed reasons for cancelling one extension invocation.",
      "oneOf": [
        {
          "description": "Authenticated caller cancelled the operation.",
          "type": "string",
          "const": "caller"
        },
        {
          "description": "Effective wall deadline elapsed.",
          "type": "string",
          "const": "deadline"
        },
        {
          "description": "Host is shutting down.",
          "type": "string",
          "const": "shutdown"
        },
        {
          "description": "A hard resource ceiling was exceeded.",
          "type": "string",
          "const": "resource_limit"
        }
      ]
    }
  }
}
