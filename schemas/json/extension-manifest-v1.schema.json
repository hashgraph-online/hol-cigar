{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionManifestV1",
  "description": "Signed extension package declaration. Cryptographic verification is a host responsibility.",
  "type": "object",
  "properties": {
    "compatible_cigar_versions": {
      "description": "Inclusive compatible CIGAR versions.",
      "$ref": "#/$defs/CigarVersionRange"
    },
    "determinism": {
      "description": "Deterministic-output promise.",
      "$ref": "#/$defs/ExtensionDeterminism"
    },
    "entry_point": {
      "description": "Package-relative executable, component, export, or remote method selector.",
      "type": "string",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "extension_id": {
      "description": "Stable normalized extension identity.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$"
    },
    "extension_version": {
      "description": "Declared extension package version.",
      "$ref": "#/$defs/ExtensionSemanticVersion"
    },
    "filesystem_preopens": {
      "description": "Sorted unique logical filesystem preopens.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SandboxPreopen"
      },
      "maxItems": 64
    },
    "implementation_digest": {
      "description": "Digest of exact executable or component bytes.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "kinds": {
      "description": "Sorted unique implemented extension roles.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtensionKind"
      },
      "maxItems": 12,
      "minItems": 1
    },
    "limits": {
      "description": "Requested hard resource ceilings.",
      "$ref": "#/$defs/ExtensionLimits"
    },
    "network_allowlist": {
      "description": "Sorted unique exact brokered network endpoints.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkEndpoint"
      },
      "maxItems": 64
    },
    "package_digest": {
      "description": "Digest of the exact containing package.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "processors": {
      "description": "Sorted unique processor identities this implementation declares.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "minLength": 1
      },
      "maxItems": 256
    },
    "protocol_abi": {
      "description": "Inclusive logical ABI compatibility range.",
      "$ref": "#/$defs/ExtensionAbiVersionRange"
    },
    "publisher_key_id": {
      "description": "Trusted publisher key selector.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$"
    },
    "publisher_public_key": {
      "description": "Ed25519 public key asserted by the publisher.",
      "type": "string",
      "maxLength": 43,
      "minLength": 43
    },
    "required_host_capabilities": {
      "description": "Sorted unique broker capabilities requested before activation.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtensionHostCapability"
      },
      "maxItems": 32
    },
    "runtime": {
      "description": "Execution environment required by this package.",
      "$ref": "#/$defs/ExtensionRuntimeKind"
    },
    "schema_bindings": {
      "description": "Sorted one-to-one schema binding for every declared role.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtensionSchemaBinding"
      },
      "maxItems": 12,
      "minItems": 1
    },
    "schema_version": {
      "description": "Must be `cigar.extension-manifest.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    },
    "signature": {
      "description": "Ed25519 signature over the signature-excluded canonical manifest envelope.",
      "type": "string",
      "maxLength": 86,
      "minLength": 86
    },
    "source_classifications": {
      "description": "Sorted unique source classifications this implementation can receive.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Classification"
      },
      "maxItems": 4
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "extension_version",
    "runtime",
    "protocol_abi",
    "implementation_digest",
    "package_digest",
    "publisher_key_id",
    "publisher_public_key",
    "signature",
    "entry_point",
    "kinds",
    "schema_bindings",
    "source_classifications",
    "processors",
    "determinism",
    "required_host_capabilities",
    "network_allowlist",
    "filesystem_preopens",
    "limits",
    "compatible_cigar_versions"
  ],
  "$defs": {
    "CigarVersionRange": {
      "description": "Inclusive CIGAR application versions compatible with an extension.",
      "type": "object",
      "properties": {
        "maximum": {
          "description": "Newest compatible CIGAR version.",
          "$ref": "#/$defs/ExtensionSemanticVersion"
        },
        "minimum": {
          "description": "Oldest compatible CIGAR version.",
          "$ref": "#/$defs/ExtensionSemanticVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ]
    },
    "Classification": {
      "description": "Closed information-classification states.",
      "oneOf": [
        {
          "description": "Safe for unrestricted publication.",
          "type": "string",
          "const": "public"
        },
        {
          "description": "Restricted to the owning organization.",
          "type": "string",
          "const": "internal"
        },
        {
          "description": "Confidential protected context.",
          "type": "string",
          "const": "confidential"
        },
        {
          "description": "Highest sensitivity requiring explicit grants.",
          "type": "string",
          "const": "restricted"
        }
      ]
    },
    "ExtensionAbiVersionRange": {
      "description": "Inclusive protocol-ABI versions supported by an extension.",
      "type": "object",
      "properties": {
        "maximum": {
          "description": "Newest supported ABI version.",
          "$ref": "#/$defs/ExtensionSemanticVersion"
        },
        "minimum": {
          "description": "Oldest supported ABI version.",
          "$ref": "#/$defs/ExtensionSemanticVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ]
    },
    "ExtensionComputeBudget": {
      "description": "Backend-specific compute ceiling.",
      "oneOf": [
        {
          "description": "Deterministic WASM fuel units.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fuel"
            },
            "units": {
              "description": "Nonzero fuel ceiling.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "units"
          ]
        },
        {
          "description": "Native or remote CPU-time ceiling.",
          "type": "object",
          "properties": {
            "duration": {
              "description": "Nonzero CPU duration.",
              "type": "integer",
              "format": "uint64",
              "maximum": 315576000000000000,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "cpu_time"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "duration"
          ]
        }
      ]
    },
    "ExtensionDeterminism": {
      "description": "Whether an extension promises deterministic semantic output.",
      "oneOf": [
        {
          "description": "Identical declared inputs and host transcript produce identical semantic output.",
          "type": "string",
          "const": "deterministic"
        },
        {
          "description": "Output must be captured as an explicit observation.",
          "type": "string",
          "const": "nondeterministic"
        }
      ]
    },
    "ExtensionHostCapability": {
      "description": "Closed host authorities that an extension may request.",
      "oneOf": [
        {
          "description": "Read content through an opaque source handle.",
          "type": "string",
          "const": "source_read"
        },
        {
          "description": "Read content through an opaque blob handle.",
          "type": "string",
          "const": "blob_read"
        },
        {
          "description": "Advance a bounded host-owned iterator.",
          "type": "string",
          "const": "bounded_iterator"
        },
        {
          "description": "Read an invocation-fixed deterministic clock.",
          "type": "string",
          "const": "deterministic_clock"
        },
        {
          "description": "Read from an invocation-fixed deterministic random stream.",
          "type": "string",
          "const": "deterministic_random"
        },
        {
          "description": "Emit bounded structured trace events.",
          "type": "string",
          "const": "structured_tracing"
        },
        {
          "description": "Observe invocation cancellation.",
          "type": "string",
          "const": "cancellation"
        },
        {
          "description": "Request brokered network I/O to an allowlisted endpoint.",
          "type": "string",
          "const": "network"
        },
        {
          "description": "Read through a declared filesystem preopen.",
          "type": "string",
          "const": "filesystem_read"
        },
        {
          "description": "Write through a declared filesystem preopen.",
          "type": "string",
          "const": "filesystem_write"
        },
        {
          "description": "Forward an opaque secret handle to a final host-owned boundary.",
          "type": "string",
          "const": "secret_handle"
        }
      ]
    },
    "ExtensionKind": {
      "description": "Closed v1 extension roles.",
      "oneOf": [
        {
          "description": "Discovers or reads a governed source.",
          "type": "string",
          "const": "source_connector"
        },
        {
          "description": "Converts source content into immutable atoms.",
          "type": "string",
          "const": "atomizer"
        },
        {
          "description": "Produces authorized retrieval candidates.",
          "type": "string",
          "const": "retriever"
        },
        {
          "description": "Produces one bounded ranking feature.",
          "type": "string",
          "const": "ranking_feature"
        },
        {
          "description": "Produces an evidence-carrying representation transform.",
          "type": "string",
          "const": "transform"
        },
        {
          "description": "Verifies a summary against declared evidence.",
          "type": "string",
          "const": "summary_verifier"
        },
        {
          "description": "Counts or encodes tokens under one fingerprint.",
          "type": "string",
          "const": "tokenizer"
        },
        {
          "description": "Renders a semantic bundle for a consumer.",
          "type": "string",
          "const": "materializer"
        },
        {
          "description": "Supplies a policy decision through the trusted policy boundary.",
          "type": "string",
          "const": "policy_provider"
        },
        {
          "description": "Implements a storage backend behind trusted repository traits.",
          "type": "string",
          "const": "storage_backend"
        },
        {
          "description": "Performs one authorized effect connector operation.",
          "type": "string",
          "const": "effect_connector"
        },
        {
          "description": "Reconciles an ambiguous external effect.",
          "type": "string",
          "const": "reconciler"
        }
      ]
    },
    "ExtensionLimits": {
      "description": "Complete bounded resource profile for one extension invocation.",
      "type": "object",
      "properties": {
        "compute": {
          "description": "Fuel or CPU-time ceiling.",
          "$ref": "#/$defs/ExtensionComputeBudget"
        },
        "max_concurrency": {
          "description": "Maximum simultaneous invocations.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "max_host_calls": {
          "description": "Maximum brokered calls during one invocation.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_input_bytes": {
          "description": "Maximum exact input bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_memory_bytes": {
          "description": "Maximum guest memory bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_output_bytes": {
          "description": "Maximum exact output bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_recursion_depth": {
          "description": "Maximum guest recursion depth.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "wall_deadline": {
          "description": "Maximum elapsed wall time.",
          "type": "integer",
          "format": "uint64",
          "maximum": 315576000000000000,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_memory_bytes",
        "compute",
        "wall_deadline",
        "max_input_bytes",
        "max_output_bytes",
        "max_concurrency",
        "max_recursion_depth",
        "max_host_calls"
      ]
    },
    "ExtensionRuntimeKind": {
      "description": "Closed v1 extension execution environments.",
      "oneOf": [
        {
          "description": "Trusted extension linked into the host process.",
          "type": "string",
          "const": "built_in"
        },
        {
          "description": "Third-party WASI Preview 2 component.",
          "type": "string",
          "const": "wasi_preview2"
        },
        {
          "description": "Third-party native executable in an operating-system sandbox.",
          "type": "string",
          "const": "isolated_subprocess"
        },
        {
          "description": "Shared-profile remote gRPC implementation.",
          "type": "string",
          "const": "remote_grpc"
        }
      ]
    },
    "ExtensionSchemaBinding": {
      "description": "Per-kind exact input and output schema bindings.",
      "type": "object",
      "properties": {
        "input_schema_digest": {
          "description": "Exact input schema digest.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        },
        "kind": {
          "description": "Extension role whose wire schemas are bound.",
          "$ref": "#/$defs/ExtensionKind"
        },
        "output_schema_digest": {
          "description": "Exact output schema digest.",
          "type": "string",
          "maxLength": 68,
          "minLength": 68,
          "pattern": "^1220[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "input_schema_digest",
        "output_schema_digest"
      ]
    },
    "ExtensionSemanticVersion": {
      "description": "Unambiguous integer semantic version used by extension compatibility ranges.",
      "type": "object",
      "properties": {
        "major": {
          "description": "Semantic major version.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minor": {
          "description": "Semantic minor version.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "patch": {
          "description": "Semantic patch version.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor",
        "patch"
      ]
    },
    "NetworkEndpoint": {
      "description": "One exact brokered network allowlist entry.",
      "type": "object",
      "properties": {
        "host": {
          "description": "Exact canonical destination host.",
          "type": "string",
          "maxLength": 253,
          "minLength": 1
        },
        "port": {
          "description": "Nonzero destination port.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "transport": {
          "description": "Authenticated transport.",
          "$ref": "#/$defs/NetworkTransport"
        }
      },
      "additionalProperties": false,
      "required": [
        "transport",
        "host",
        "port"
      ]
    },
    "NetworkTransport": {
      "description": "Network protocol permitted for a brokered endpoint.",
      "oneOf": [
        {
          "description": "HTTPS with authenticated TLS.",
          "type": "string",
          "const": "https"
        },
        {
          "description": "gRPC over authenticated TLS.",
          "type": "string",
          "const": "grpc_tls"
        },
        {
          "description": "Other application protocol over authenticated TLS.",
          "type": "string",
          "const": "tls_tcp"
        }
      ]
    },
    "SandboxAccess": {
      "description": "Filesystem authority requested for one sandbox preopen.",
      "oneOf": [
        {
          "description": "Read-only package or operator-provided directory.",
          "type": "string",
          "const": "read_only"
        },
        {
          "description": "Explicit read/write directory.",
          "type": "string",
          "const": "read_write"
        }
      ]
    },
    "SandboxPreopen": {
      "description": "One normalized logical filesystem preopen.",
      "type": "object",
      "properties": {
        "access": {
          "description": "Maximum requested access.",
          "$ref": "#/$defs/SandboxAccess"
        },
        "path": {
          "description": "Guest-visible normalized relative path.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "access"
      ]
    }
  }
}
