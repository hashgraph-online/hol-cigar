{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompensationLink",
  "description": "Link from a succeeded original effect to a separately authorized compensation effect.",
  "type": "object",
  "properties": {
    "compensation_effect_id": {
      "description": "Separately journaled compensation effect identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "compensation_spec_digest": {
      "description": "Digest binding the original compensation specification.",
      "type": "string",
      "maxLength": 68,
      "minLength": 68,
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "created_at": {
      "description": "Creation time.",
      "type": "string",
      "format": "date-time"
    },
    "original_effect_id": {
      "description": "Original succeeded effect identity.",
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {
      "description": "Must be `cigar.compensation-link.v1`.",
      "type": "string",
      "maxLength": 71,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]{0,4}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "original_effect_id",
    "compensation_effect_id",
    "compensation_spec_digest",
    "created_at"
  ]
}
