{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::cigar-shared"],
      "Condition": {"StringLike": {"s3:prefix": ["cigar-v1/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::cigar-shared/cigar-v1/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::cigar-shared/cigar-v1/*/staging/*",
        "arn:aws:s3:::cigar-shared/cigar-v1/*/probes/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::cigar-shared/cigar-v1/*/objects/*"]
    }
  ]
}
