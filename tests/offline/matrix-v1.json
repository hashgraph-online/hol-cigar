{
  "schema_version": "cigar.test-matrix.v1",
  "suite": "offline",
  "description": "macOS-local offline and no-egress gates for replay, focus branches, and store-owned maintenance.",
  "cases": [
    {
      "id": "OFFLINE-REPLAY-001",
      "title": "Non-live replay succeeds while a macOS sandbox denies every network operation.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--config-file",
        ".config/nextest.toml",
        "--user-config-file",
        "none",
        "-P",
        "macos-qualification",
        "--no-tests",
        "fail",
        "-p",
        "cigar-replay",
        "--test",
        "wp13_no_egress"
      ],
      "timeout_seconds": 1200,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["RPL-NO-EGRESS-001", "VER-HERMETIC-001"]
    },
    {
      "id": "OFFLINE-REPLAY-002",
      "title": "Exact non-live replay consumes only retained bytes and recorded boundaries.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--config-file",
        ".config/nextest.toml",
        "--user-config-file",
        "none",
        "-P",
        "macos-qualification",
        "--no-tests",
        "fail",
        "-p",
        "cigar-replay",
        "--test",
        "wp13_replay_modes",
        "-E",
        "test(=exact_non_live_modes_use_only_retained_bytes_and_recorded_boundaries)"
      ],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["RPL-OFFLINE-001", "RPL-EXACT-SOURCE-001"]
    },
    {
      "id": "OFFLINE-SPACE-001",
      "title": "Offline focus branches checkpoint, switch, and resume without hidden online state.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--config-file",
        ".config/nextest.toml",
        "--user-config-file",
        "none",
        "-P",
        "macos-qualification",
        "--no-tests",
        "fail",
        "-p",
        "cigar-space",
        "--test",
        "space",
        "-E",
        "test(=offline_focus_branches_checkpoint_switch_and_resume_exactly)"
      ],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["SPACE-OFFLINE-001", "SPACE-RESUME-001"]
    },
    {
      "id": "OFFLINE-STORE-001",
      "title": "One-shot offline garbage collection preserves candidates until its locked sweep.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--config-file",
        ".config/nextest.toml",
        "--user-config-file",
        "none",
        "-P",
        "macos-qualification",
        "--no-tests",
        "fail",
        "-p",
        "cigar-store",
        "--test",
        "store_owned_gc",
        "-E",
        "test(=one_shot_offline_gc_preserves_candidates_until_the_locked_sweep)"
      ],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-OFFLINE-GC-001", "STORE-LOCK-001"]
    }
  ]
}
