{
  "schema_version": "cigar.test-matrix.v1",
  "suite": "integration",
  "description": "macOS-local integration gates for atomic ingestion, deterministic compilation, reference connectors, handoff, and store-owned garbage collection.",
  "cases": [
    {
      "id": "INT-CODE-INTEL-001",
      "title": "Interrupted code ingestion remains invisible and exact retry is idempotent.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--config-file",
        ".config/nextest.toml",
        "--user-config-file",
        "none",
        "-P",
        "macos-qualification",
        "--no-tests",
        "fail",
        "-p",
        "cigar-code-intel",
        "--test",
        "ingestion",
        "-E",
        "test(=interrupted_ingestion_is_invisible_and_exact_retry_is_idempotent)"
      ],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["IDX-ATOMIC-001", "IDX-RETRY-001"]
    },
    {
      "id": "INT-COMPILER-001",
      "title": "Compiler permutations and parallel execution produce one identical bundle.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--config-file",
        ".config/nextest.toml",
        "--user-config-file",
        "none",
        "-P",
        "macos-qualification",
        "--no-tests",
        "fail",
        "-p",
        "cigar-compiler",
        "--test",
        "compiler",
        "-E",
        "test(=golden_bundle_permutation_and_parallel_execution_are_identical)"
      ],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["CTX-DETERMINISM-001", "CTX-PARALLEL-001"]
    },
    {
      "id": "INT-COMPILER-002",
      "title": "Context deltas round-trip exactly and reject the wrong base, tampering, and target changes.",
