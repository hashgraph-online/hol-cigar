{
  "schema_version": "cigar.test-matrix.v1",
  "suite": "migration",
  "description": "Append-only migration, tamper detection, backup/restore, snapshot compatibility, and live shared upgrade gates.",
  "cases": [
    {
      "id": "MIG-AUTH-001",
      "title": "The closed migration authority rejects rewritten, missing, reordered, mirrored, or path-unsafe SQL.",
      "command": ["python3", "-m", "unittest", "scripts.migrations.tests.test_validate_migration_authority"],
      "timeout_seconds": 120,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-MIGRATION-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-BACKUP-001",
      "title": "Signed SQLite backup verifies, restores, and preserves the semantic root.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--lib", "-E", "test(=backup::tests::signed_backup_verifies_restores_empty_and_preserves_root)"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["linux", "macos", "windows"],
      "requirements": ["STORE-BACKUP-001", "STORE-RESTORE-001"]
    },
    {
      "id": "MIG-CLI-001",
      "title": "Production CLI backup, restore, and store-owned GC use signed durable state.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-cli", "--lib", "-E", "test(=tests::production_backup_restore_and_store_owned_gc_use_signed_durable_state)"],
      "timeout_seconds": 1200,
      "profiles": ["local", "release"],
      "platforms": ["linux", "macos", "windows"],
      "requirements": ["OPS-BACKUP-001", "OPS-RESTORE-001", "STORE-GC-001"]
    },
    {
      "id": "MIG-POSTGRES-LIVE-001",
      "title": "TLS-only PostgreSQL recovers every real migration process-abort boundary with exact ledgers, semantic roots, mixed-version writes, and least-privilege roles.",
      "command": ["python3", "scripts/migrations/qualify_postgres_tls.py"],
      "timeout_seconds": 1800,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-PG-MIGRATION-001", "STORE-INTEGRITY-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-POSTGRES-STATIC-001",
      "title": "Embedded PostgreSQL migration sources are contiguous, digest-bound, rolling-classified, and transaction-owner neutral.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--lib", "-E", "test(=postgres::tests::postgres_migration_sources_are_contiguous_rolling_and_self_describing)"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-PG-MIGRATION-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-SHARED-001",
      "title": "Live PostgreSQL and object storage migrations, physical backup, restore, and deployment assets qualify together.",
      "command": ["bash", "tools/qualify-shared-profile.sh"],
      "timeout_seconds": 14400,
      "profiles": ["release", "shared"],
      "platforms": ["linux", "macos"],
      "requirements": ["STORE-PG-MIGRATION-001", "STORE-BACKUP-001", "STORE-RESTORE-001"]
    },
    {
      "id": "MIG-SPACE-001",
      "title": "Space and handoff snapshots reject semantic tampering and duplicate state.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-space", "--test", "space", "--test", "handoff"],
      "timeout_seconds": 1200,
      "profiles": ["local", "release"],
      "platforms": ["linux", "macos", "windows"],
      "requirements": ["STATE-SNAPSHOT-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-SQLITE-001",
      "title": "SQLite detects migration and durable state tampering.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--lib", "-E", "test(=conformance::tests::sqlite_detects_migration_and_state_tampering)"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["linux", "macos", "windows"],
      "requirements": ["STORE-MIGRATION-001", "STORE-INTEGRITY-001"]
    },
    {
      "id": "MIG-SQLITE-002",
      "title": "Migration plans are append-only, bounded, and self-describing.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--lib", "-E", "test(=conformance::tests::migration_plan_is_append_only_bounded_and_self_describing)"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["linux", "macos", "windows"],
      "requirements": ["STORE-MIGRATION-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-SQLITE-003",
      "title": "Retained SQLite v1 upgrades through v4 recover at every migration boundary with equal semantic roots and explicit downgrade refusal.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--lib", "-E", "test(sqlite::migration_tests)"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-MIGRATION-001", "STORE-INTEGRITY-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-SQLITE-004",
      "title": "Generation-bound SQLite/FTS projections fail closed when stale, recover corruption, and switch atomically for concurrent readers.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--lib", "-E", "test(sqlite::projection_generation_tests)"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-MIGRATION-001", "STORE-INTEGRITY-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-SQLITE-005",
      "title": "Process death at every SQLite/FTS generation build and activation boundary recovers one complete generation.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--features", "projection-fault-injection", "--test", "sqlite_projection_process"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-MIGRATION-001", "STORE-INTEGRITY-001", "COMPAT-UPGRADE-001"]
    },
    {
      "id": "MIG-SQLITE-006",
      "title": "Process death at all 19 retained SQLite v1-to-v4 migration-ledger boundaries preserves the exact durable prefix and semantic root before atomic v4 activation.",
      "command": ["cargo", "nextest", "run", "--locked", "--config-file", ".config/nextest.toml", "--user-config-file", "none", "-P", "macos-qualification", "--no-tests", "fail", "-p", "cigar-store", "--features", "migration-fault-injection", "--test", "sqlite_migration_process"],
      "timeout_seconds": 900,
      "profiles": ["local", "release"],
      "platforms": ["macos"],
      "requirements": ["STORE-MIGRATION-001", "STORE-INTEGRITY-001", "COMPAT-UPGRADE-001"]
    }
  ]
}
