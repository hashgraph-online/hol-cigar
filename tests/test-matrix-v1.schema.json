{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.dev/schemas/test-matrix-v1.schema.json",
  "title": "CIGAR test matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "description", "cases"],
  "properties": {
    "schema_version": {"const": "cigar.test-matrix.v1"},
    "suite": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{2,95}$"},
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{2,95}$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "command", "timeout_seconds", "profiles", "platforms", "requirements"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "macos", "windows"]}},
        "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "required_environment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,95}$"}},
        "isolate_home": {"type": "boolean"}
      }
    }
  }
}
