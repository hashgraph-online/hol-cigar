{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/beta-qualification-policy.v1.schema.json",
  "title": "CIGAR beta qualification policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_profile", "product_version", "categories"],
  "properties": {
    "schema_version": {"const": "cigar.beta.qualification-policy.v1"},
    "release_profile": {"const": "cigar.beta.embedded-local.linux-x86_64.v1"},
    "product_version": {"const": "0.1.0-beta.1"},
    "categories": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/category"},
      "allOf": [
        {"contains": {"properties": {"id": {"const": "archive-contract"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "conformance"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "docs"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "installed-artifact"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "license"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "offline"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "provenance"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "reproducibility"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "sbom"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "security"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "signature"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "artifactId": {"enum": ["source", "docs", "schemas", "conformance", "licenses", "cigar-linux-x86_64-gnu"]},
    "metricGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "operator", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "integer"},
        "operator": {"enum": ["eq", "gte", "lte"]},
        "value": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_ids", "required_checks", "metric_gates", "minimum_attachments"],
      "properties": {
        "id": {"enum": ["archive-contract", "conformance", "docs", "installed-artifact", "license", "offline", "provenance", "reproducibility", "sbom", "security", "signature"]},
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactId"}
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "metric_gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/metricGate"}
        },
        "minimum_attachments": {"const": 1}
      }
    }
  }
}
