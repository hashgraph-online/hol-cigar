{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/beta-spdx.v1.schema.json",
  "title": "CIGAR beta SPDX SBOM profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["spdxVersion", "dataLicense", "SPDXID", "name", "documentNamespace", "creationInfo", "documentDescribes", "documentComment", "packages", "files", "relationships"],
  "properties": {
    "spdxVersion": {"const": "SPDX-2.3"},
    "dataLicense": {"const": "CC0-1.0"},
    "SPDXID": {"const": "SPDXRef-DOCUMENT"},
    "name": {"const": "cigar-0.1.0-beta.1-beta-candidate"},
    "documentNamespace": {"type": "string", "pattern": "^https://cigar\\.invalid/spdx/[0-9a-f]{64}$"},
    "creationInfo": {"type": "object", "additionalProperties": false, "required": ["created", "creators"], "properties": {"created": {"type": "string"}, "creators": {"const": ["Tool: cigar-beta-artifacts-0.1.0-beta.1"]}}},
    "documentDescribes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^SPDXRef-"}},
    "documentComment": {"type": "string", "minLength": 1},
    "packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
    "relationships": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}}
  }
}
