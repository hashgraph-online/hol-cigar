{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/beta-sbom.v1.schema.json",
  "title": "CIGAR beta CycloneDX SBOM profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["bomFormat", "specVersion", "serialNumber", "version", "metadata", "components", "dependencies", "properties"],
  "properties": {
    "bomFormat": {"const": "CycloneDX"},
    "specVersion": {"const": "1.6"},
    "serialNumber": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "version": {"const": 1},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["timestamp", "component"], "properties": {"timestamp": {"type": "string"}, "component": {"type": "object"}}},
    "components": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "name", "version", "purl", "bom-ref", "licenses"],
        "properties": {
          "type": {"enum": ["application", "library"]},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "purl": {"type": "string", "pattern": "^pkg:(cargo|generic)/"},
          "bom-ref": {"type": "string", "pattern": "^pkg:(cargo|generic)/"},
          "licenses": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
          "hashes": {"type": "array", "items": {"type": "object"}},
          "properties": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "dependencies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "dependsOn"],
        "properties": {"ref": {"type": "string", "minLength": 1}, "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
      }
    },
    "properties": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}}
  }
}
