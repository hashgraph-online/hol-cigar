{
  "schema_version": "cigar.package-contract.v1",
  "id": "macos-dashboard-archive-v1",
  "formats": ["tar.gz"],
  "allow": [
    "RELEASE-METADATA.json",
    "LICENSE",
    "NOTICE",
    "SHA256SUMS",
    "bin/cigar-dashboard",
    "etc/cigar-dashboard/cigar-dashboard.example.toml",
    "share/cigar-dashboard/assets/**",
    "share/doc/cigar-dashboard/**"
  ],
  "deny": [
    "bin/cigar-soak",
    "**/.git/**",
    "**/.env*",
    "**/*.key",
    "**/*.pem",
    "**/*.p12",
    "**/*.mobileprovision",
    "**/*.dSYM/**",
    "**/*.map",
    "**/*.rlib",
    "**/*.rmeta",
    "**/target/**",
    "**/history*",
    "**/runtime/**",
    "**/evidence/**",
    "**/sandbox/**",
    "**/token*"
  ],
  "required": [
    "RELEASE-METADATA.json",
    "LICENSE",
    "NOTICE",
    "SHA256SUMS",
    "bin/cigar-dashboard",
    "etc/cigar-dashboard/cigar-dashboard.example.toml",
    "share/cigar-dashboard/assets/app.20260713.css",
    "share/cigar-dashboard/assets/app.20260713.js",
    "share/cigar-dashboard/assets/asset-manifest.v1.json",
    "share/cigar-dashboard/assets/browser-security.20260714.js",
    "share/cigar-dashboard/assets/controls.20260714.js",
    "share/cigar-dashboard/assets/health-details.20260713.js",
    "share/cigar-dashboard/assets/index.html",
    "share/cigar-dashboard/assets/live-updates.20260713.js",
    "share/cigar-dashboard/assets/preferences.20260713.js",
    "share/cigar-dashboard/assets/protocol-catalog.20260713.js",
    "share/cigar-dashboard/assets/theme.20260713.css",
    "share/doc/cigar-dashboard/index.md",
    "share/doc/cigar-dashboard/operator-guide.md",
    "share/doc/cigar-dashboard/security.md",
    "share/doc/cigar-dashboard/testing.md",
    "share/doc/cigar-dashboard/troubleshooting.md"
  ],
  "symlinks": "forbid",
  "line_endings": "lf",
  "modes": ["0644", "0755"],
  "max_entries": 64,
  "max_member_bytes": 536870912,
  "max_total_bytes": 1073741824,
  "content_scan": true,
  "content_scan_exemptions": [],
  "checksum_manifest": {"path": "SHA256SUMS", "scope": "all-payload-files"},
  "version_binding": {"path_pattern": "RELEASE-METADATA.json", "format": "json", "json_pointer": "/product_version"},
  "abi_binding": {"path_pattern": "RELEASE-METADATA.json", "format": "json", "json_pointer": "/context_abi"}
}
