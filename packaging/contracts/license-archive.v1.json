{
  "schema_version": "cigar.package-contract.v1",
  "id": "license-archive-v1",
  "formats": ["tar.gz"],
  "allow": ["RELEASE-METADATA.json", "LICENSE", "NOTICE", "SECURITY.md", "packaging/licenses/**"],
  "deny": ["**/.git/**", "**/.env*", "**/*.key", "**/*.pem"],
  "required": ["RELEASE-METADATA.json", "NOTICE", "SECURITY.md", "packaging/licenses/Apache-2.0.txt", "packaging/licenses/third-party-policy.v1.json", "packaging/licenses/third-party-inventory.v1.json"],
  "symlinks": "forbid",
  "line_endings": "lf",
  "modes": ["0644"],
  "max_entries": 20000,
  "max_member_bytes": 8388608,
  "max_total_bytes": 33554432,
  "content_scan": true,
  "content_scan_exemptions": []
}
