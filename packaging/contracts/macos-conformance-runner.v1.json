{
  "schema_version": "cigar.package-contract.v1",
  "id": "macos-conformance-runner-v1",
  "formats": ["tar.gz"],
  "allow": [
    "RELEASE-METADATA.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SHA256SUMS",
    "bin/cigar-conformance",
    "bin/cigar-install-qualifier",
    "share/cigar/prd.md",
    "share/cigar/tests/invariants.yaml",
    "share/cigar/reports/conformance-result.v1.json",
    "share/cigar/crates/xtask/src/lib.rs",
    "share/cigar/conformance/runner/tests/conformance.rs",
    "share/cigar/conformance/runner/tests/traceability.rs",
    "share/cigar/conformance/profiles/requirements-v1.json",
    "share/cigar/conformance/profiles/faults-v1.json",
    "share/cigar/conformance/runner/src/bin/cigar-conformance-faulty.rs",
    "share/cigar/conformance/profiles/v1.json",
    "share/cigar/conformance/vectors/v1/core-v1.json",
    "share/cigar/conformance/vectors/v1/fixture.toml",
    "share/cigar/conformance/expected/cigar-catalog-v1.txt",
    "share/cigar/conformance/expected/cigar-compiler-v1.txt",
    "share/cigar/conformance/expected/cigar-core-v1.txt",
    "share/cigar/conformance/expected/cigar-effect-v1.txt",
    "share/cigar/conformance/expected/cigar-handoff-v1.txt",
    "share/cigar/conformance/expected/cigar-replay-v1.txt",
    "share/cigar/conformance/expected/cigar-runtime-claude-code-v1.txt",
    "share/cigar/conformance/expected/cigar-service-v1.txt"
  ],
  "deny": [
    "**/.git/**",
    "**/.env*",
    "**/*.key",
    "**/*.pem",
    "**/*.dSYM/**",
    "**/*.rlib",
    "**/*.rmeta",
    "**/target/**"
  ],
  "required": [
    "RELEASE-METADATA.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SHA256SUMS",
    "bin/cigar-conformance",
    "bin/cigar-install-qualifier",
    "share/cigar/prd.md",
    "share/cigar/tests/invariants.yaml",
    "share/cigar/reports/conformance-result.v1.json",
    "share/cigar/crates/xtask/src/lib.rs",
    "share/cigar/conformance/runner/tests/conformance.rs",
    "share/cigar/conformance/runner/tests/traceability.rs",
    "share/cigar/conformance/profiles/requirements-v1.json",
    "share/cigar/conformance/profiles/faults-v1.json",
    "share/cigar/conformance/runner/src/bin/cigar-conformance-faulty.rs",
    "share/cigar/conformance/profiles/v1.json",
    "share/cigar/conformance/vectors/v1/core-v1.json",
    "share/cigar/conformance/vectors/v1/fixture.toml",
    "share/cigar/conformance/expected/cigar-catalog-v1.txt",
    "share/cigar/conformance/expected/cigar-compiler-v1.txt",
    "share/cigar/conformance/expected/cigar-core-v1.txt",
    "share/cigar/conformance/expected/cigar-effect-v1.txt",
    "share/cigar/conformance/expected/cigar-handoff-v1.txt",
    "share/cigar/conformance/expected/cigar-replay-v1.txt",
    "share/cigar/conformance/expected/cigar-runtime-claude-code-v1.txt",
    "share/cigar/conformance/expected/cigar-service-v1.txt"
  ],
  "symlinks": "forbid",
  "line_endings": "lf",
  "modes": ["0644", "0755"],
  "max_entries": 64,
  "max_member_bytes": 268435456,
  "max_total_bytes": 536870912,
  "content_scan": true,
  "content_scan_exemptions": [],
  "checksum_manifest": {
    "path": "SHA256SUMS",
    "scope": "all-payload-files"
  },
  "version_binding": {
    "path_pattern": "RELEASE-METADATA.json",
    "format": "json",
    "json_pointer": "/product_version"
  },
  "abi_binding": {
    "path_pattern": "RELEASE-METADATA.json",
    "format": "json",
    "json_pointer": "/context_abi"
  }
}
