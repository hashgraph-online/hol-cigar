{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/operation-exercise-summary.v1.schema.json",
  "title": "CIGAR operation exercise evidence summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "source_revision", "artifact_ids", "subject_manifest_sha256", "source_date_epoch", "status", "exercise_count", "exercises", "receipts"],
  "properties": {
    "schema_version": {"const": "cigar.operation-exercise-summary.v1"},
    "mode": {"enum": ["static", "live"]},
    "source_revision": {"type": "string", "minLength": 1},
    "artifact_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "source_date_epoch": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "subject_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "passed"},
    "exercise_count": {"const": 8},
    "exercises": {
      "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["backup", "restore", "key-rotation", "migration", "index-rebuild", "unknown-effect", "journal-quarantine", "adapter-disable"]}
    },
    "receipts": {
      "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["exercise", "path", "sha256", "bytes"],
        "properties": {
          "exercise": {"enum": ["backup", "restore", "key-rotation", "migration", "index-rebuild", "unknown-effect", "journal-quarantine", "adapter-disable"]},
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.(?:static|live)\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
