{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/source-descriptor.v1.schema.json",
  "title": "CIGAR immutable source candidate descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "git", "source_archive", "policy_inputs", "tool_inputs"],
  "properties": {
    "schema_version": {"const": "cigar.source-descriptor.v1"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree", "committed", "clean", "status_entry_count", "status_sha256"],
      "properties": {
        "revision": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "committed": {"const": true},
        "clean": {"type": "boolean"},
        "status_entry_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "status_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_archive": {"$ref": "#/$defs/archive"},
    "policy_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/input"}
    },
    "tool_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/input"}
    }
  },
  "$defs": {
    "gitObject": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!.*[/\\\\])(?!\\.\\.?$)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    }
  }
}
