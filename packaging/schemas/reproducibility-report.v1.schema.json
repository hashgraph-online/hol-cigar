{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/reproducibility-report.v1.schema.json",
  "title": "CIGAR two-builder reproducibility report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "status", "source_date_epoch", "source", "environment", "artifacts"],
  "properties": {
    "schema_version": {"const": "cigar.reproducibility-report.v1"},
    "scope": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "source_date_epoch": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "source": {"$ref": "#/$defs/source"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["timezone", "locale", "python_hash_seed", "network_required"],
      "properties": {
        "timezone": {"const": "UTC"}, "locale": {"const": "C"},
        "python_hash_seed": {"const": "0"}, "network_required": {"const": false}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "builder_a_sha256", "builder_b_sha256", "bytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "builder_a_sha256": {"$ref": "#/$defs/sha256"},
          "builder_b_sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "tree_sha256", "committed", "clean"],
      "properties": {
        "revision": {"type": "string", "minLength": 1}, "tree_sha256": {"$ref": "#/$defs/sha256"},
        "committed": {"type": "boolean"}, "clean": {"type": "boolean"}
      }
    }
  }
}
