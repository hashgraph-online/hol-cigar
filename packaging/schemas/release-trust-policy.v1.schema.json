{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/release-trust-policy.v1.schema.json",
  "title": "CIGAR offline release trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "cigar.release-trust-policy.v1"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "public_key", "public_key_sha256", "signer_principal", "purposes", "status", "active_from"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "public_key": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
          "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signer_principal": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"}
          },
          "status": {"enum": ["active", "retired", "revoked"]},
          "active_from": {"type": "integer", "minimum": 0, "maximum": 253402300799},
          "retired_at": {"type": "integer", "minimum": 0, "maximum": 253402300799}
        }
      }
    }
  }
}
