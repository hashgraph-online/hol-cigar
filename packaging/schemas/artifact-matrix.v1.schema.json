{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/artifact-matrix.v1.schema.json",
  "title": "CIGAR artifact matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "product_version", "context_abi", "release_state", "artifacts"],
  "properties": {
    "schema_version": {"const": "cigar.artifact-matrix.v1"},
    "product": {"const": "cigar"},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "context_abi": {"const": "cigar.context.v1"},
    "release_state": {"enum": ["development", "release"]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "filename", "contract", "required_for_release", "qualification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "contract": {"type": "string", "pattern": "^contracts/[a-z0-9-]+\\.v1\\.json$"},
          "producer": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "ecosystem": {"type": "string", "minLength": 1},
          "signature_purpose": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "install_target": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "evidence_map": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
          "required_for_release": {"type": "boolean"},
          "qualification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
        }
      }
    }
  }
}
