{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/operation-exercise.v1.schema.json",
  "title": "CIGAR operator runbook exercise",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exercise", "mode", "source_revision", "artifact_ids", "subject_manifest_sha256", "producer", "status", "checks", "source_date_epoch"],
  "properties": {
    "schema_version": {"const": "cigar.operation-exercise.v1"},
    "exercise": {"enum": ["backup", "restore", "key-rotation", "migration", "index-rebuild", "unknown-effect", "journal-quarantine", "adapter-disable"]},
    "mode": {"enum": ["static", "live"]},
    "source_revision": {"type": "string", "minLength": 1},
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "source_date_epoch": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "subject_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[^/\\\\\u0000-\u001f\u007f]{1,255}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {"enum": ["passed", "failed"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "status": {"enum": ["passed", "failed"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
        }
      }
    }
  }
}
