{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/locked-upstream-license-evidence.v1.schema.json",
  "title": "CIGAR locked upstream license evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "limitations", "license_files", "records"],
  "properties": {
    "schema_version": {"const": "cigar.locked-upstream-license-evidence.v1"},
    "scope": {"const": "locked-source-license-metadata-only"},
    "limitations": {
      "const": [
        "This source authority records technical metadata and is not legal approval.",
        "Final packaged bytes and transitive native members require separate reconciliation."
      ]
    },
    "license_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/license_file"}
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "https_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "license_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "bytes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "algorithm", "digest"],
      "properties": {
        "path": {"enum": ["pnpm-lock.yaml", "sdk/python/uv.lock"]},
        "algorithm": {"enum": ["sha256", "sha512"]},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}([0-9a-f]{64})?$"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "bytes"],
      "properties": {
        "url": {"$ref": "#/$defs/https_url"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "canonical_subset_sha256", "subset"],
      "properties": {
        "url": {"$ref": "#/$defs/https_url"},
        "canonical_subset_sha256": {"$ref": "#/$defs/sha256"},
        "subset": {"type": "object"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "name",
        "version",
        "purl",
        "license_expression",
        "lock",
        "archive",
        "metadata",
        "license_file_ids"
      ],
      "properties": {
        "ecosystem": {"enum": ["npm", "pypi"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "purl": {"type": "string", "pattern": "^pkg:(npm|pypi)/.+@.+$"},
        "license_expression": {"type": "string", "minLength": 1},
        "lock": {"$ref": "#/$defs/lock"},
        "archive": {"$ref": "#/$defs/archive"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "license_file_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
        }
      }
    }
  }
}
