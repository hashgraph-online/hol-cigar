{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigar.invalid/schemas/post-beta-capability-ownership.v1.schema.json",
  "title": "CIGAR post-beta capability ownership and boundary registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "capability_profile",
    "artifact_matrix",
    "release_claimed",
    "support_claimed",
    "fail_closed",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": "cigar.post-beta.capability-ownership.v1"},
    "profile_id": {"const": "cigar.post-beta.macos-arm64.v1"},
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "packaging/post-beta-capability-profile.v1.json"},
        "sha256": {"const": "f7b24ccdda679a7046db4d016db349e15ef462c2ea58221821cbda7113ef61ae"}
      }
    },
    "artifact_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "artifact_id_inventory_sha256"],
      "properties": {
        "path": {"const": "packaging/artifact-matrix.v1.json"},
        "schema_version": {"const": "cigar.artifact-matrix.v1"},
        "artifact_id_inventory_sha256": {"const": "b5f25d88f278943ff7f3fe9cea42d335df272913afa4538d1acb30071ecec1c7"}
      }
    },
    "release_claimed": {"const": false},
    "support_claimed": {"const": false},
    "fail_closed": {"const": true},
    "capabilities": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "catalog-discovery"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "catalog-ingest"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "catalog-query"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "context"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "retrieval"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "handoff"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "space"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "replay"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "policy"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "daemon"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "effects"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "extensions"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "installers"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "macos"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "mcp"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "oci"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "otlp"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "plugin"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "remote"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "sdk"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "shared"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "vector"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "windows"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "arm"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "backup"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "garbage-collection"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "diagnostics"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "serving"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "completion-man"}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "status": {"enum": ["existing", "planned", "missing"]}
      }
    },
    "selectedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "profile_id", "target_triple"],
      "properties": {
        "disposition": {"const": "selected"},
        "profile_id": {"const": "cigar.post-beta.macos-arm64.v1"},
        "target_triple": {"const": "aarch64-apple-darwin"}
      }
    },
    "deferredScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "platform", "reason"],
      "properties": {
        "disposition": {"const": "deferred-separate-profile"},
        "platform": {"enum": ["windows-x86_64", "linux-oci-multiarch"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code_owner",
        "support_owner",
        "authority_boundary",
        "persistence_boundary",
        "artifact_set",
        "profile_scope",
        "test_inventory",
        "operations_docs",
        "rollback_or_disable"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "code_owner": {"$ref": "#/$defs/owner"},
        "support_owner": {"$ref": "#/$defs/owner"},
        "authority_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "persistence_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "artifact_set": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "profile_scope": {
          "oneOf": [
            {"$ref": "#/$defs/selectedScope"},
            {"$ref": "#/$defs/deferredScope"}
          ]
        },
        "test_inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "operations_docs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "rollback_or_disable": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
