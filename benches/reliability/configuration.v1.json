    "disk_full",
    "read_only_filesystem",
    "fsync_error",
    "truncated_checkpoint",
    "corrupt_index",
    "stale_watermark",
    "missing_blob",
    "permission_change",
    "clock_rollback",
    "clock_advance",
    "worker_panic",
    "vector_outage_permitted_degradation",
    "vector_outage_required_fail_closed",
    "tokenizer_unavailable",
    "tokenizer_wrong_digest",
    "tokenizer_crash",
    "tokenizer_timeout",
    "tokenizer_oversized_output",
    "materializer_unavailable",
    "materializer_wrong_digest",
    "materializer_crash",
    "materializer_timeout",
    "materializer_oversized_output"
  ],
  "soak_duration_seconds": 86400,
  "sample_interval_seconds": 10,
  "warmup_seconds": 3600,
  "maximum_sample_gap_seconds": 30,
  "memory_slope_maximum_bytes_per_hour": 0,
  "content_forbidden_keys": [
    "atom_content",
    "credential",
    "prompt",
    "query",
    "source_path",
    "source_uri",
    "tenant_name",
    "tool_arguments"
  ]
