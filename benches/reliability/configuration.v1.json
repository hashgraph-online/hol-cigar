{
  "schema_version": "cigar.h094-reliability-configuration.v1",
  "retained_record_counts": [8, 128, 4096, 100000, 1000000],
  "compile_concurrency": [1, 2, 4, 8, 16],
  "compile_queue_capacity": 32,
  "compile_iterations_per_cell": 40,
  "required_lifecycle_phases": [
    "cold_start_nanoseconds",
    "steady_state_nanoseconds",
